    <p class="empty-state" id="empty-state" hidden>No pins match <strong id="empty-query"></strong>. Try a different word or category.</p>
</div>

<script>
    // ────── hero atom-particles ──────
    (function () {
        var c = document.getElementById('hero-particles');
        if (!c) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        var ctx = c.getContext('2d');
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var W = 0, H = 0;
        var particles = [];
        var COUNT = 52;
        var MAX_DIST = 138;
        var raf = null;
        var visible = true;

        function size() {
            var r = c.getBoundingClientRect();
            W = r.width;
            H = r.height;
            if (W < 2 || H < 2) return;
            c.width = Math.round(W * dpr);
            c.height = Math.round(H * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        function init() {
            size();
            particles = [];
            for (var i = 0; i < COUNT; i++) {
                particles.push({
                    x: Math.random() * W,
                    y: Math.random() * H,
                    vx: (Math.random() - 0.5) * 0.22,
                    vy: (Math.random() - 0.5) * 0.22,
                    r: 1 + Math.random() * 1.2
                });
            }
        }

        function tick() {
            ctx.clearRect(0, 0, W, H);
            ctx.lineWidth = 0.85;
            for (var i = 0; i < particles.length; i++) {
                for (var j = i + 1; j < particles.length; j++) {
                    var a = particles[i], b = particles[j];
                    var dx = a.x - b.x, dy = a.y - b.y;
                    var d2 = dx * dx + dy * dy;
                    if (d2 < MAX_DIST * MAX_DIST) {
                        var alpha = (1 - d2 / (MAX_DIST * MAX_DIST)) * 0.40;
                        ctx.strokeStyle = 'rgba(255, 232, 205,' + alpha + ')';
                        ctx.beginPath();
                        ctx.moveTo(a.x, a.y);
                        ctx.lineTo(b.x, b.y);
                        ctx.stroke();
                    }
                }
            }
            for (var k = 0; k < particles.length; k++) {
                var p = particles[k];
                p.x += p.vx; p.y += p.vy;
                if (p.x < 0 || p.x > W) p.vx *= -1;
                if (p.y < 0 || p.y > H) p.vy *= -1;
                ctx.fillStyle = 'rgba(255, 240, 220, 0.82)';
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                ctx.fill();
            }
            raf = requestAnimationFrame(tick);
        }

        if ('IntersectionObserver' in window) {
            var heroIo = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    visible = e.isIntersecting;
                    if (visible && !raf) raf = requestAnimationFrame(tick);
                    else if (!visible && raf) { cancelAnimationFrame(raf); raf = null; }
                });
            }, { rootMargin: '40px' });
            heroIo.observe(c);
        }

        init();
        raf = requestAnimationFrame(tick);

        var resizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(init, 200);
        }, { passive: true });
    })();

    // ────── count-up on numbers pin ──────
    (function () {
        var pin = document.querySelector('.pin--numbers');
        if (!pin) return;
        var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var nums = pin.querySelectorAll('.pin__num[data-value]');
        if (reduced || !('IntersectionObserver' in window)) {
            nums.forEach(function (n) { n.textContent = n.dataset.value; });
            return;
        }
        function ease(t) { return 1 - Math.pow(1 - t, 3); }
        function run(el) {
            var target = parseInt(el.dataset.value, 10) || 0;
            var start = performance.now();
            var dur = 1200;
            function step(t) {
                var p = Math.min((t - start) / dur, 1);
                el.textContent = Math.round(target * ease(p));
                if (p < 1) requestAnimationFrame(step);
                else el.textContent = target;
            }
            requestAnimationFrame(step);
        }
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) {
                    io.unobserve(e.target);
                    nums.forEach(run);
                }
            });
        }, { threshold: 0.45 });
        io.observe(pin);
    })();

    (function () {
        // live countdown on open-call pins
        function daysUntil(iso) {
            return Math.ceil((new Date(iso + 'T23:59:59Z').getTime() - Date.now()) / 86400000);
        }
        document.querySelectorAll('.pin--call').forEach(function (pin) {
            var iso = pin.dataset.deadline;
            if (!iso) return;
            var d = daysUntil(iso);
            var t = pin.querySelector('.pin__countdown .t');
            if (!t) return;
            if (d > 0)        t.textContent = 'Open · ' + d + ' day' + (d === 1 ? '' : 's') + ' remaining';
            else if (d === 0) t.textContent = 'Closes today';
            else              t.textContent = 'Closed';
        });

        // relative-time chip on events
        function relWhen(iso) {
            var diff = Math.ceil((new Date(iso + 'T00:00:00Z').getTime() - Date.now()) / 86400000);
            if (diff < 0)   return { text: 'Past', cls: '' };
            if (diff < 7)   return { text: 'This week', cls: 'pin__when--soon' };
            if (diff < 14)  return { text: 'Next week', cls: 'pin__when--soon' };
            if (diff < 31)  return { text: 'This month', cls: 'pin__when--near' };
            if (diff < 92)  return { text: 'In ' + Math.round(diff / 30) + ' months', cls: '' };
            if (diff < 366) return { text: 'Later this year', cls: '' };
            var yrs = Math.floor(diff / 365);
            return { text: 'In ' + yrs + ' year' + (yrs === 1 ? '' : 's'), cls: '' };
        }
        document.querySelectorAll('[data-rel]').forEach(function (el) {
            var r = relWhen(el.dataset.rel);
            el.textContent = r.text;
            if (r.cls) el.classList.add(r.cls);
        });

        // filter chips + search
        var chips  = document.querySelectorAll('.chip');
        var pins   = document.querySelectorAll('.pin');
        var search = document.getElementById('board-search');
        var empty  = document.getElementById('empty-state');
        var emptyQ = document.getElementById('empty-query');
        var current = { filter: 'all', query: '' };

        var allChip = document.querySelector('.chip[data-filter="all"] .chip__count');
        if (allChip) allChip.textContent = pins.length;
        chips.forEach(function (c) {
            var f = c.dataset.filter;
            if (f === 'all') return;
            var n = 0;
            pins.forEach(function (p) {
                if ((p.dataset.tags || '').split(' ').indexOf(f) !== -1) n++;
            });
            var el = c.querySelector('.chip__count');
            if (el) el.textContent = n;
        });

        function apply() {
            var visible = 0;
            pins.forEach(function (p) {
                var tags = (p.dataset.tags || '').split(' ');
                var catOK = current.filter === 'all' || tags.indexOf(current.filter) !== -1;
                var qOK   = !current.query || (p.textContent || '').toLowerCase().indexOf(current.query) !== -1;
                var show  = catOK && qOK;
                p.classList.toggle('pin--hidden', !show);
                if (show) visible++;
            });
            // toggle filtered-mode (collapse section heads) when not "all"
            if (current.filter !== 'all' || current.query) {
                document.body.classList.add('filtered');
            } else {
                document.body.classList.remove('filtered');
            }
            if (visible === 0 && current.query) {
                empty.hidden = false;
                emptyQ.textContent = '“' + current.query + '”';
            } else {
                empty.hidden = true;
            }
        }

        chips.forEach(function (c) {
            c.addEventListener('click', function () {
                chips.forEach(function (x) { x.classList.remove('chip--active'); x.setAttribute('aria-selected', 'false'); });
                c.classList.add('chip--active');
                c.setAttribute('aria-selected', 'true');
                current.filter = c.dataset.filter;
                apply();
            });
        });

        if (search) {
            search.addEventListener('input', function () {
                current.query = search.value.toLowerCase().trim();
                apply();
            });
        }

        // staggered fade-in
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            pins.forEach(function (p) { p.classList.add('in-view'); });
            return;
        }
        if (!('IntersectionObserver' in window)) {
            pins.forEach(function (p) { p.classList.add('in-view'); });
            return;
        }
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) {
                    e.target.classList.add('in-view');
                    io.unobserve(e.target);
                }
            });
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0.05 });
        pins.forEach(function (p) { io.observe(p); });
    })();
</script>
{% endblock %}
