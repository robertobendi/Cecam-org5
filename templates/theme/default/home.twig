{% extends '@theme/layout.twig' %}

{% set nav_active = 'home' %}

{% block title %}CECAM — A third way of doing science, since 1969{% endblock %}

{% block styles %}
        /* ─────────────────────────────────────── home (sectioned board) ─── */

        :root {
            --board:        #F4EEDE;
            --card:         #FFFFFF;
            --line:         rgba(15, 42, 92, 0.08);
            --line-strong:  rgba(15, 42, 92, 0.18);
            --tint:         rgba(15, 42, 92, 0.045);

            /* derived from the CECAM logo: red, sky blue, near-black, navy */
            --cat-call:        #C8232E;   /* logo red */
            --cat-workshop:    #3E8FC9;   /* logo sky blue */
            --cat-school:      #496B96;   /* slate-blue, derived midtone */
            --cat-conference:  #1A1F2E;   /* near-black, logo 4th hue */
            --cat-news:        #0F2A5C;   /* navy */
            --cat-series:      #0F2A5C;   /* navy */
            --cat-about:       #0F2A5C;   /* navy */

            --pin-radius:   14px;
            --pin-shadow-h: 0 4px 12px rgba(15,42,92,0.06), 0 14px 30px rgba(15,42,92,0.10);
        }

        body { background: var(--board); }

        /* ─── BRAND HERO with EPFL aerial photo + particles ─── */
        .brand-hero {
            position: relative;
            width: 100%;
            min-height: clamp(420px, 54vw, 580px);
            overflow: hidden;
            isolation: isolate;
        }
        .brand-hero__bg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
            filter: saturate(0.34) contrast(1.18) brightness(0.62);
            transform: scale(1.06);
            animation: heroDrift 30s ease-in-out infinite alternate;
        }
        @keyframes heroDrift {
            0%   { transform: scale(1.06) translateX(0); }
            100% { transform: scale(1.08) translateX(-1.2%); }
        }
        .brand-hero__veil {
            position: absolute;
            inset: 0;
            z-index: 1;
            background:
              linear-gradient(180deg, rgba(11,31,71,0.55) 0%, rgba(8,22,55,0.78) 60%, rgba(5,15,40,0.94) 100%),
              radial-gradient(circle at 80% 20%, rgba(200,35,46,0.10) 0%, transparent 45%);
        }
        .brand-hero__particles {
            position: absolute;
            inset: 0;
            z-index: 2;
            width: 100%;
            height: 100%;
            pointer-events: none;
            opacity: 0.55;
        }
        .brand-hero__content {
            position: relative;
            z-index: 3;
            max-width: var(--container);
            margin: 0 auto;
            padding: clamp(2rem, 5vw, 3.5rem) var(--gutter) clamp(2.2rem, 5vw, 3.5rem);
            min-height: clamp(420px, 54vw, 580px);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            color: var(--paper);
            gap: clamp(0.8rem, 1.4vw, 1.2rem);
        }
        .brand-hero__eyebrow {
            font-family: 'Geist Mono', ui-monospace, monospace;
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: rgba(246, 244, 238, 0.85);
            margin: 0;
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
        }
        .brand-hero__eyebrow .dot {
            width: 6px;
            height: 6px;
            background: var(--cat-call);
            border-radius: 50%;
            box-shadow: 0 0 0 0 rgba(200,35,46,0.55);
            animation: callPulse 2.2s ease-in-out infinite;
        }
        .brand-hero h1 {
            color: var(--paper);
            font-family: 'Geist', sans-serif;
            font-weight: 700;
            font-size: clamp(2.4rem, 6.2vw, 4.6rem);
            line-height: 0.98;
            letter-spacing: -0.038em;
            margin: 0;
            max-width: 18ch;
        }
        .brand-hero h1 .accent { color: #FFB39E; }
        .brand-hero__sub {
            color: rgba(246, 244, 238, 0.88);
            font-family: 'Geist', sans-serif;
            font-size: clamp(1rem, 1.3vw, 1.18rem);
            line-height: 1.5;
            margin: 0;
            max-width: 56ch;
            letter-spacing: -0.005em;
        }
        .brand-hero__search {
            position: relative;
            max-width: 540px;
            margin-top: 0.4rem;
        }
        .brand-hero__search input {
            width: 100%;
            background: rgba(255,255,255,0.96);
            border: 1px solid rgba(255,255,255,0.6);
            border-radius: 999px;
            padding: 0.95rem 1.2rem 0.95rem 2.95rem;
            font-family: 'Geist', sans-serif;
            font-size: 1rem;
            color: var(--ink);
            min-height: 54px;
            box-shadow: 0 6px 24px rgba(8, 30, 71, 0.25);
            transition: box-shadow 180ms ease;
        }
        .brand-hero__search input::placeholder { color: var(--muted); }
        .brand-hero__search input:focus {
            outline: none;
            background: white;
            box-shadow: 0 0 0 4px rgba(255,255,255,0.4), 0 6px 24px rgba(8, 30, 71, 0.3);
        }
        .brand-hero__search svg {
            position: absolute;
            left: 1.1rem;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            color: var(--muted);
            pointer-events: none;
        }
        .brand-hero__stats {
            margin-top: 0.4rem;
            display: flex;
            flex-wrap: wrap;
            gap: 1.6rem 2rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.74rem;
            color: rgba(246, 244, 238, 0.7);
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .brand-hero__stats strong { color: var(--paper); font-weight: 600; }
        .brand-hero__stats .sep { opacity: 0.25; }

        /* ─── STICKY FILTER CHIPS ─── */
        .chips {
            position: sticky;
            top: 72px;
            z-index: 30;
            background: rgba(244, 238, 222, 0.92);
            backdrop-filter: saturate(140%) blur(10px);
            -webkit-backdrop-filter: saturate(140%) blur(10px);
            border-bottom: 1px solid var(--line);
            padding: 0.8rem 0;
        }
        .chips__row {
            max-width: var(--container);
            margin: 0 auto;
            padding: 0 var(--gutter);
            display: flex;
            gap: 0.4rem;
            overflow-x: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
            -webkit-overflow-scrolling: touch;
        }
        .chips__row::-webkit-scrollbar { display: none; }
        .chip {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: transparent;
            border: 1px solid var(--line-strong);
            color: var(--ink-soft);
            font-family: 'Geist', sans-serif;
            font-size: 0.86rem;
            font-weight: 500;
            letter-spacing: -0.005em;
            padding: 0.45rem 0.9rem;
            border-radius: 999px;
            cursor: pointer;
            transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
            white-space: nowrap;
            min-height: 36px;
        }
        .chip:hover { background: rgba(15,42,92,0.04); color: var(--navy); border-color: rgba(15,42,92,0.28); }
        .chip--active { background: var(--navy); color: var(--paper); border-color: var(--navy); }
        .chip--active:hover { background: var(--navy-hover); color: var(--paper); border-color: var(--navy-hover); }
        .chip__count {
            font-family: 'Geist Mono', monospace;
            font-size: 0.7rem;
            opacity: 0.6;
            font-weight: 400;
        }
        .chip--active .chip__count { opacity: 0.78; }

        /* ─── BOARD SECTIONS (editorial) ─── */
        .board { padding: 0 0 clamp(4rem, 7vw, 5rem); }
        .board-section {
            max-width: var(--container);
            margin: 0 auto;
            padding: clamp(2.2rem, 4vw, 3.2rem) var(--gutter) 0;
        }
        .board-section + .board-section { padding-top: clamp(2rem, 3.5vw, 2.8rem); }

        .section__head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1.5rem;
            margin-bottom: clamp(1.25rem, 2vw, 1.8rem);
            padding-bottom: 0.9rem;
            border-bottom: 1px solid var(--line-strong);
        }
        .section__head__group { display: flex; flex-direction: column; gap: 0.4rem; }
        .section__eyebrow {
            font-family: 'Geist Mono', ui-monospace, monospace;
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--muted);
            margin: 0;
        }
        .section__title {
            font-family: 'Geist', sans-serif;
            font-weight: 700;
            font-size: clamp(1.45rem, 2.6vw, 2rem);
            line-height: 1.05;
            letter-spacing: -0.028em;
            color: var(--navy);
            margin: 0;
        }
        .section__more {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-family: 'Geist', sans-serif;
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--navy);
            padding-bottom: 0.2rem;
            text-decoration: none;
            white-space: nowrap;
        }
        .section__more:hover { color: var(--cat-call); }
        .section__more .arrow { transition: transform 180ms ease; }
        .section__more:hover .arrow { transform: translateX(3px); }

        /* section grids */
        .section__grid--featured {
            display: grid;
            grid-template-columns: 1.7fr 1fr;
            gap: 1.25rem;
            align-items: stretch;
        }
        .section__grid--events {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.25rem;
            align-items: stretch;
        }
        .section__grid--news {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
            align-items: stretch;
        }
        .section__grid--series {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
            align-items: stretch;
        }
        .section__grid--about {
            column-count: 4;
            column-gap: 1.25rem;
        }

        @media (max-width: 1180px) {
            .section__grid--events { grid-template-columns: repeat(2, 1fr); }
            .section__grid--about  { column-count: 3; }
        }
        @media (max-width: 880px) {
            .section__grid--featured { grid-template-columns: 1fr; }
            .section__grid--news { grid-template-columns: repeat(2, 1fr); }
            .section__grid--series { grid-template-columns: repeat(2, 1fr); }
            .section__grid--about { column-count: 2; }
        }
        @media (max-width: 520px) {
            .section__grid--events,
            .section__grid--news,
            .section__grid--series { grid-template-columns: 1fr; }
            .section__grid--about { column-count: 1; }
            .section__head { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
        }

        /* when a filter is active, sections collapse — flat list mode */
        body.filtered .section__head { display: none; }
        body.filtered .board-section,
        body.filtered .board-section + .board-section { padding-top: 1rem; }

        /* ─── PIN ─── */
        .pin {
            display: block;
            background: var(--card);
            border: 1px solid var(--line);
            border-left: 3px solid var(--line-strong);
            border-radius: var(--pin-radius);
            margin: 0;
            overflow: hidden;
            text-decoration: none;
            color: inherit;
            position: relative;
            transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
                        box-shadow 240ms cubic-bezier(0.22, 1, 0.36, 1),
                        border-color 240ms ease;
            opacity: 0;
            transform: translateY(10px);
        }
        /* masonry section: pins get bottom margin */
        .section__grid--about .pin { margin: 0 0 1.25rem; break-inside: avoid; page-break-inside: avoid; }

        .pin.in-view {
            opacity: 1;
            transform: translateY(0);
            transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1), opacity 520ms ease;
        }
        a.pin:hover {
            transform: translateY(-2px);
            border-color: var(--line-strong);
            box-shadow: var(--pin-shadow-h);
        }
        .pin--hidden { display: none; }

        .pin[data-cat="call"]       { border-left-color: var(--cat-call); }
        .pin[data-cat="workshop"]   { border-left-color: var(--cat-workshop); }
        .pin[data-cat="school"]     { border-left-color: var(--cat-school); }
        .pin[data-cat="conference"] { border-left-color: var(--cat-conference); }
        .pin[data-cat="news"]       { border-left-color: var(--cat-news); }
        .pin[data-cat="series"]     { border-left-color: var(--cat-series); }
        .pin[data-cat="about"]      { border-left-color: var(--cat-about); }

        .pin__body { padding: 1.2rem 1.25rem 1.3rem; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
        .pin__top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.6rem;
            flex-wrap: wrap;
        }
        .pin__tag {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: var(--tint);
            color: var(--ink-soft);
            padding: 0.32rem 0.7rem;
            border-radius: 999px;
            font-family: 'Geist', sans-serif;
            font-size: 0.72rem;
            font-weight: 500;
            white-space: nowrap;
        }
        .pin__tag .dot { width: 6px; height: 6px; background: currentColor; border-radius: 50%; flex-shrink: 0; }
        .pin__tag[data-cat="call"]       { color: var(--cat-call); }
        .pin__tag[data-cat="workshop"]   { color: var(--cat-workshop); }
        .pin__tag[data-cat="school"]     { color: var(--cat-school); }
        .pin__tag[data-cat="conference"] { color: var(--cat-conference); }
        .pin__tag[data-cat="news"]       { color: var(--cat-news); }
        .pin__tag[data-cat="series"]     { color: var(--cat-series); }
        .pin__tag[data-cat="about"]      { color: var(--cat-about); }

        .pin__when {
            font-family: 'Geist Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .pin__when--soon { color: var(--cat-call); font-weight: 500; }
        .pin__when--near { color: var(--ink-soft); }

        .pin__title {
            font-family: 'Geist', sans-serif;
            font-weight: 600;
            font-size: 1.02rem;
            line-height: 1.28;
            letter-spacing: -0.012em;
            color: var(--navy);
            margin: 0;
        }
        .pin__desc {
            font-family: 'Geist', sans-serif;
            font-size: 0.88rem;
            line-height: 1.55;
            color: var(--ink-soft);
            margin: 0;
        }
        .pin__meta {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.05em;
            color: var(--muted);
        }
        .pin__meta svg { width: 13px; height: 13px; opacity: 0.7; flex-shrink: 0; }
        .pin__cta {
            margin-top: 0.4rem;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-family: 'Geist', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            color: var(--navy);
        }
        .pin__cta .arrow { transition: transform 200ms ease; }
        a.pin:hover .pin__cta .arrow { transform: translateX(3px); }

        .pin__img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: cover;
            background: var(--paper-warm);
            transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        .pin__img-wrap { overflow: hidden; background: var(--paper-warm); }
        a.pin:hover .pin__img { transform: scale(1.03); }

        /* ─── PIN VARIANTS ─── */

        .pin--event { display: flex; flex-direction: column; }
        .pin--event .pin__date {
            display: flex;
            align-items: baseline;
            gap: 0.6rem;
            margin: 0.25rem 0 0.3rem;
        }
        .pin--event .pin__day {
            font-family: 'Geist', sans-serif;
            font-weight: 700;
            font-size: 2.4rem;
            line-height: 0.95;
            letter-spacing: -0.04em;
            color: var(--navy);
        }
        .pin--event .pin__mon { font-weight: 600; font-size: 0.92rem; color: var(--ink-soft); }

        /* spotlight open-call pin */
        .pin--call .pin__countdown {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: rgba(200, 35, 46, 0.10);
            color: var(--cat-call);
            padding: 0.4rem 0.75rem;
            border-radius: 999px;
            font-family: 'Geist Mono', monospace;
            font-size: 0.74rem;
            font-weight: 500;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            align-self: flex-start;
        }
        .pin--call .pin__countdown .dot {
            width: 6px; height: 6px;
            background: var(--cat-call);
            border-radius: 50%;
            box-shadow: 0 0 0 0 rgba(200,35,46,0.55);
            animation: callPulse 2.2s ease-in-out infinite;
        }
        @keyframes callPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(200,35,46,0.5); }
            50%      { box-shadow: 0 0 0 6px rgba(200,35,46,0); }
        }
        .pin--call .pin__title { font-size: 1.18rem; line-height: 1.25; }
        .pin--call .pin__cta { color: var(--cat-call); }

        .pin--spotlight .pin__body { padding: clamp(1.4rem, 2.5vw, 2rem) clamp(1.5rem, 2.5vw, 2rem) clamp(1.6rem, 2.6vw, 2.2rem); gap: 0.85rem; }
        .pin--spotlight .pin__title { font-size: clamp(1.35rem, 2vw, 1.6rem); line-height: 1.18; max-width: 24ch; }
        .pin--spotlight .pin__desc { max-width: 48ch; }

        /* third-way quote */
        .pin--quote {
            background:
              radial-gradient(circle at 80% 10%, rgba(62, 143, 201, 0.16) 0%, transparent 55%),
              radial-gradient(circle at 10% 90%, rgba(200, 35, 46, 0.08) 0%, transparent 55%),
              linear-gradient(180deg, #FFFFFF 0%, #F1ECDF 100%);
        }
        .pin--quote .pin__body { padding: 1.5rem 1.4rem 1.6rem; }
        .pin--quote .pin__quote {
            font-family: 'Geist', sans-serif;
            font-weight: 700;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            line-height: 1.18;
            letter-spacing: -0.025em;
            color: var(--navy);
            margin: 0.3rem 0 0;
        }
        .pin--quote .pin__quote .mark { color: var(--cat-call); font-size: 1.5em; line-height: 0; vertical-align: -0.18em; margin-right: 0.1em; }
        .pin--quote .pin__cite {
            margin-top: 1rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--muted);
        }

        /* numbers */
        .pin--numbers .pin__numgrid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.6rem;
            margin-top: 0.3rem;
        }
        .pin--numbers .pin__numgrid > div { display: flex; flex-direction: column; gap: 0.15rem; }
        .pin--numbers .pin__num {
            font-family: 'Geist', sans-serif;
            font-weight: 700;
            font-size: 1.75rem;
            line-height: 0.95;
            letter-spacing: -0.04em;
            color: var(--navy);
        }
        .pin--numbers .pin__numlabel {
            font-family: 'Geist Mono', monospace;
            font-size: 0.66rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--muted);
            line-height: 1.3;
        }

        /* series pin */
        .pin--series .pin__title { font-size: 1.12rem; font-weight: 700; letter-spacing: -0.02em; }

        /* network map */
        .pin--network .pin__map {
            margin: 0.4rem 0 0.2rem;
            background: var(--tint);
            border-radius: 10px;
            padding: 0.75rem 0.6rem;
        }
        .pin--network .pin__map svg { display: block; width: 100%; height: auto; }

        /* image-led pin sizing */
        .pin--image-top .pin__img-wrap { aspect-ratio: 4 / 3; }
        .pin--image-tall .pin__img-wrap { aspect-ratio: 4 / 5; }
        .pin--image-wide .pin__img-wrap { aspect-ratio: 16 / 10; }

        /* anniversary */
        .pin--anniversary { background: linear-gradient(180deg, #FFFFFF 0%, #F4EBD8 100%); }
        .pin--anniversary .pin__big50 {
            font-family: 'Geist', sans-serif;
            font-weight: 800;
            font-size: 3.6rem;
            line-height: 0.9;
            letter-spacing: -0.05em;
            color: var(--navy);
            margin: 0.5rem 0 0.4rem;
        }
        .pin--anniversary .pin__big50 .sup {
            font-size: 0.4em;
            vertical-align: 0.45em;
            margin-left: 0.1em;
            color: var(--cat-call);
            font-weight: 700;
        }

        /* prize */
        .pin--prize { background: linear-gradient(180deg, #FFFFFF 0%, #F1ECDF 100%); }
        .pin--prize .pin__img-wrap { aspect-ratio: 4 / 3; background: #0F1320; }
        .pin--prize .pin__img { object-fit: contain; padding: 0.5rem; }

        /* HQ */
        .pin--hq .pin__img-wrap { aspect-ratio: 16 / 10; }

        /* social */
        .pin--social .pin__sociallist { display: flex; flex-direction: column; gap: 0.45rem; margin-top: 0.4rem; }
        .pin--social .pin__sociallink {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.7rem 0.85rem;
            background: var(--tint);
            border-radius: 10px;
            font-family: 'Geist', sans-serif;
            font-weight: 500;
            font-size: 0.9rem;
            color: var(--navy);
            text-decoration: none;
            transition: background 180ms ease, transform 180ms ease;
        }
        .pin--social .pin__sociallink:hover { background: rgba(15,42,92,0.08); transform: translateX(2px); }
        .pin--social .pin__sociallink svg { width: 18px; height: 18px; flex-shrink: 0; color: var(--cat-about); }
        .pin--social .pin__sociallink .handle { margin-left: auto; color: var(--muted); font-family: 'Geist Mono', monospace; font-size: 0.78rem; }

        /* newsletter */
        .pin--newsletter {
            background: var(--navy);
            border-color: var(--navy);
            border-left-color: var(--paper);
            color: var(--paper);
        }
        .pin--newsletter .pin__title { color: var(--paper); }
        .pin--newsletter .pin__desc  { color: rgba(246,244,238,0.82); }
        .pin--newsletter .pin__tag   { background: rgba(246,244,238,0.10); color: rgba(246,244,238,0.92); }
        .pin--newsletter .pin__form  { margin-top: 0.4rem; display: flex; flex-direction: column; gap: 0.45rem; }
        .pin--newsletter input[type="email"] {
            background: rgba(246,244,238,0.08);
            border: 1px solid rgba(246,244,238,0.18);
            color: var(--paper);
            border-radius: 10px;
            padding: 0.7rem 0.9rem;
            font-family: 'Geist', sans-serif;
            font-size: 0.92rem;
            min-height: 44px;
            width: 100%;
        }
        .pin--newsletter input[type="email"]::placeholder { color: rgba(246,244,238,0.5); }
        .pin--newsletter input[type="email"]:focus {
            outline: none;
            border-color: var(--paper);
            background: rgba(246,244,238,0.14);
        }
        .pin--newsletter button {
            background: var(--paper);
            color: var(--navy);
            border: 0;
            padding: 0.75rem 1rem;
            font-family: 'Geist', sans-serif;
            font-weight: 600;
            font-size: 0.9rem;
            border-radius: 10px;
            cursor: pointer;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            transition: background 180ms ease;
        }
        .pin--newsletter button:hover { background: #fff; }

        .empty-state {
            text-align: center;
            padding: 4rem 1rem;
            color: var(--muted);
            font-family: 'Geist', sans-serif;
            font-size: 0.95rem;
            max-width: var(--container);
            margin: 0 auto;
        }
        .empty-state strong { color: var(--navy); font-weight: 600; }

        @media (prefers-reduced-motion: reduce) {
            .pin { opacity: 1; transform: none; }
            a.pin:hover { transform: none; }
            .pin--call .pin__countdown .dot,
            .brand-hero__eyebrow .dot { animation: none; }
            .brand-hero__bg { animation: none; transform: scale(1.06); }
        }

        @media (max-width: 640px) {
            .pin--numbers .pin__numgrid { gap: 0.4rem; }
            .pin--numbers .pin__num { font-size: 1.4rem; }
            .brand-hero h1 { font-size: clamp(2rem, 8vw, 2.8rem); }
        }
{% endblock %}

{% block content %}
