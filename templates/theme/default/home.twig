{% extends '@theme/layout.twig' %}

{% set nav_active = 'home' %}

{% block title %}CECAM — Europe's home for atomistic and molecular simulation{% endblock %}

{% block styles %}
        /* ──────────────────────── home (Lausanne Field Notes) ──────────────────────── */

        /* paper grain — adds warmth and depth */
        .field {
            position: relative;
            isolation: isolate;
        }
        .field::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.06 0 0 0 0 0.16 0 0 0 0 0.36 0 0 0 0.045 0'/></filter><rect width='200' height='200' filter='url(%23n)'/></svg>");
            mix-blend-mode: multiply;
            opacity: 0.55;
        }

        /* running dispatch strip at top — like a journal header */
        .dispatch {
            font-family: 'Geist Mono', ui-monospace, monospace;
            font-size: 0.72rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--ink-soft);
            border-bottom: 1px solid var(--hairline);
            background: var(--paper);
        }
        .dispatch__inner {
            max-width: var(--container);
            margin: 0 auto;
            padding: 0.65rem var(--gutter);
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
        }
        .dispatch span { display: inline-flex; align-items: center; gap: 0.5rem; }
        .dispatch .dot { width: 4px; height: 4px; background: currentColor; border-radius: 50%; opacity: 0.55; }
        .dispatch .live { color: var(--pulse); }
        .dispatch .live .pulse-dot { width: 6px; height: 6px; }

        /* ─── HERO ─── */
        .hero-v2 {
            position: relative;
            padding: clamp(3.5rem, 8vw, 8rem) 0 clamp(4rem, 9vw, 8rem);
            overflow: hidden;
            border-bottom: 1px solid var(--hairline);
        }
        .hero-v2 .container { position: relative; z-index: 3; }

        .hero-v2__canvas {
            position: absolute;
            inset: 0;
            z-index: 1;
            opacity: 0.85;
            pointer-events: none;
        }
        .hero-v2__grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 260px);
            gap: clamp(2rem, 5vw, 5rem);
            align-items: start;
        }
        .hero-v2__eyebrow {
            font-family: 'Geist Mono', ui-monospace, monospace;
            font-size: 0.72rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--signal);
            display: inline-flex;
            align-items: center;
            gap: 0.8rem;
            margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
        }
        .hero-v2__eyebrow::before {
            content: "";
            width: 2.2rem;
            height: 1px;
            background: var(--signal);
            opacity: 0.7;
        }

        .hero-v2 h1 {
            font-family: 'Instrument Serif', serif;
            font-weight: 400;
            font-size: clamp(3.8rem, 11.5vw, 10.5rem);
            line-height: 0.92;
            letter-spacing: -0.035em;
            color: var(--navy);
            margin: 0 0 clamp(2rem, 3.5vw, 3rem);
            max-width: 12ch;
        }
        .hero-v2 h1 em {
            font-style: italic;
            color: var(--signal);
            position: relative;
        }
        .hero-v2 h1 .word {
            display: inline-block;
            opacity: 0;
            transform: translateY(0.22em);
            animation: heroWord 900ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }
        .hero-v2 h1 .word:nth-child(1) { animation-delay: 80ms; }
        .hero-v2 h1 .word:nth-child(2) { animation-delay: 200ms; }
        .hero-v2 h1 .word:nth-child(3) { animation-delay: 320ms; }
        .hero-v2 h1 .word:nth-child(4) { animation-delay: 440ms; }
        .hero-v2 h1 .word:nth-child(5) { animation-delay: 560ms; }
        .hero-v2 h1 .word:nth-child(6) { animation-delay: 680ms; }
        @keyframes heroWord {
            0%   { opacity: 0; transform: translateY(0.22em); filter: blur(6px); }
            60%  { opacity: 1; filter: blur(0); }
            100% { opacity: 1; transform: translateY(0); filter: blur(0); }
        }

        .hero-v2__sub {
            font-family: 'Geist', sans-serif;
            font-size: clamp(1.05rem, 1.4vw, 1.2rem);
            line-height: 1.55;
            color: var(--ink-soft);
            max-width: 36em;
            margin: 0 0 clamp(2rem, 3vw, 2.5rem);
            letter-spacing: -0.005em;
        }
        .hero-v2__cta { display: flex; flex-wrap: wrap; gap: 1.2rem; align-items: center; }

        /* margin annotations — like footnotes in a manuscript */
        .field-notes {
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
            padding-top: 1rem;
            border-top: 1px solid var(--hairline);
        }
        .field-notes__item {
            display: grid;
            grid-template-columns: 1.8rem 1fr;
            gap: 0.8rem;
            font-family: 'Geist Mono', ui-monospace, monospace;
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--muted);
            line-height: 1.45;
        }
        .field-notes__num { color: var(--signal); font-weight: 500; }
        .field-notes__body strong {
            display: block;
            font-family: 'Instrument Serif', serif;
            font-weight: 400;
            font-size: 2rem;
            line-height: 1;
            letter-spacing: -0.02em;
            color: var(--navy);
            text-transform: none;
            margin-bottom: 0.35rem;
            font-style: italic;
        }

        /* ─── REFINED RIBBON ─── */
        .ribbon-v2 {
            background: var(--navy);
            color: var(--paper);
            position: relative;
            overflow: hidden;
            border-bottom: 1px solid rgba(246,244,238,0.08);
        }
        .ribbon-v2::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
              radial-gradient(circle at 85% 20%, rgba(46,125,193,0.22) 0%, transparent 50%),
              radial-gradient(circle at 15% 100%, rgba(200,34,44,0.10) 0%, transparent 55%);
        }
        .ribbon-v2__inner {
            position: relative;
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 3rem;
            padding: clamp(2.5rem, 5vw, 4rem) 0;
            align-items: center;
        }
        .ribbon-v2__chip {
            display: inline-flex;
            align-items: center;
            gap: 0.7rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--paper);
            opacity: 0.92;
            margin-bottom: 1.1rem;
        }
        .ribbon-v2 h2 {
            font-family: 'Instrument Serif', serif;
            color: var(--paper);
            font-size: clamp(1.7rem, 3.5vw, 2.7rem);
            line-height: 1.08;
            letter-spacing: -0.018em;
            margin: 0 0 1rem;
            max-width: 22ch;
            font-weight: 400;
        }
        .ribbon-v2 h2 em { color: rgba(217, 231, 243, 1); font-style: italic; }
        .ribbon-v2__deadline {
            font-family: 'Geist Mono', monospace;
            font-size: 0.85rem;
            color: rgba(246, 244, 238, 0.78);
            letter-spacing: 0.04em;
        }
        .ribbon-v2__deadline strong { color: var(--paper); font-weight: 500; }

        /* ─── SECTION CHAPTER MARKERS ─── */
        .chapter {
            padding: clamp(4rem, 8vw, 7rem) 0 clamp(1rem, 2vw, 1.5rem);
        }
        .chapter--tight { padding-top: clamp(2.5rem, 5vw, 4rem); }
        .chapter__head {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 2rem;
            align-items: end;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--navy);
            margin-bottom: clamp(2.5rem, 5vw, 4rem);
        }
        .chapter__num {
            font-family: 'Geist Mono', monospace;
            font-size: 0.78rem;
            letter-spacing: 0.14em;
            color: var(--signal);
            text-transform: uppercase;
            margin: 0 0 1rem;
        }
        .chapter__title {
            font-family: 'Instrument Serif', serif;
            font-size: clamp(2.2rem, 5vw, 3.6rem);
            line-height: 1.0;
            letter-spacing: -0.028em;
            color: var(--navy);
            margin: 0;
            font-weight: 400;
            max-width: 22ch;
        }
        .chapter__title em { font-style: italic; color: var(--signal); }
        .chapter__meta {
            font-family: 'Geist Mono', monospace;
            font-size: 0.74rem;
            letter-spacing: 0.14em;
            color: var(--muted);
            text-transform: uppercase;
            white-space: nowrap;
            padding-bottom: 0.4rem;
        }
        .chapter__meta a { color: var(--navy); border-bottom: 1px solid var(--hairline-strong); padding-bottom: 1px; }
        .chapter__meta a:hover { color: var(--signal); border-color: var(--signal); }

        /* ─── BULLETIN (news as table of contents) ─── */
        .bulletin { display: grid; gap: 0; }
        .bulletin__item {
            display: grid;
            grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 320px);
            gap: clamp(1rem, 3vw, 2.5rem);
            padding: clamp(1.5rem, 3vw, 2.2rem) 0;
            border-top: 1px solid var(--hairline);
            text-decoration: none;
            color: inherit;
            position: relative;
            transition: background-color 320ms ease;
            align-items: start;
        }
        .bulletin__item:last-child { border-bottom: 1px solid var(--hairline); }
        .bulletin__item:hover { background: rgba(46,125,193,0.04); }
        .bulletin__item:hover .bulletin__title { color: var(--signal); }
        .bulletin__num {
            font-family: 'Geist Mono', monospace;
            font-size: 0.78rem;
            letter-spacing: 0.1em;
            color: var(--signal);
            font-weight: 500;
            padding-top: 0.4rem;
        }
        .bulletin__body { display: flex; flex-direction: column; gap: 0.5rem; }
        .bulletin__meta {
            font-family: 'Geist Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .bulletin__title {
            font-family: 'Instrument Serif', serif;
            font-weight: 400;
            font-size: clamp(1.5rem, 2.6vw, 2.1rem);
            line-height: 1.1;
            letter-spacing: -0.015em;
            color: var(--navy);
            margin: 0;
            transition: color 220ms ease;
            max-width: 22ch;
        }
        .bulletin__title em { font-style: italic; color: var(--signal); }
        .bulletin__excerpt {
            font-size: 0.95rem;
            color: var(--ink-soft);
            line-height: 1.55;
            margin: 0.4rem 0 0;
            max-width: 42em;
        }
        .bulletin__more {
            font-family: 'Geist Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--signal);
            margin-top: 0.6rem;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
        }
        .bulletin__more .arrow { transition: transform 200ms ease; }
        .bulletin__item:hover .bulletin__more .arrow { transform: translateX(4px); }
        .bulletin__thumb {
            aspect-ratio: 4 / 3;
            background: var(--paper-warm);
            overflow: hidden;
            position: relative;
            border: 1px solid var(--hairline);
        }
        .bulletin__thumb img {
            width: 100%; height: 100%; object-fit: cover;
            transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1), filter 700ms;
            filter: saturate(0.95);
        }
        .bulletin__item:hover .bulletin__thumb img { transform: scale(1.04); filter: saturate(1.05); }

        /* ─── TIMELINE (events horizontal strip) ─── */
        .timeline {
            position: relative;
            padding-top: 1rem;
        }
        .timeline__axis {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: var(--hairline);
        }
        .timeline__grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: clamp(1.5rem, 4vw, 3rem);
        }
        .timeline__event {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding-top: 2rem;
            text-decoration: none;
            color: inherit;
            position: relative;
            min-height: 320px;
        }
        .timeline__event::before {
            content: "";
            position: absolute;
            top: -5px;
            left: 0;
            width: 9px;
            height: 9px;
            background: var(--navy);
            border-radius: 50%;
            transition: background 200ms ease, transform 200ms ease;
        }
        .timeline__event:hover::before { background: var(--signal); transform: scale(1.35); }
        .timeline__month {
            font-family: 'Geist Mono', monospace;
            font-size: 0.74rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .timeline__date {
            font-family: 'Instrument Serif', serif;
            font-weight: 400;
            font-size: clamp(2.6rem, 4.6vw, 3.4rem);
            line-height: 0.95;
            letter-spacing: -0.025em;
            color: var(--navy);
            margin: 0.2rem 0 0.4rem;
            font-style: italic;
        }
        .timeline__event h3 {
            font-family: 'Instrument Serif', serif;
            font-weight: 400;
            font-size: clamp(1.2rem, 2vw, 1.45rem);
            line-height: 1.2;
            letter-spacing: -0.012em;
            color: var(--navy);
            margin: 0.6rem 0 0;
        }
        .timeline__event:hover h3 { color: var(--signal); }
        .timeline__venue {
            margin-top: auto;
            padding-top: 1.2rem;
            border-top: 1px solid var(--hairline);
            font-family: 'Geist', sans-serif;
            font-size: 0.88rem;
            line-height: 1.5;
            color: var(--ink-soft);
        }
        .timeline__venue strong { color: var(--navy); font-weight: 500; display: block; margin-bottom: 0.2rem; }

        /* ─── PERIODIC TABLE (activities) ─── */
        .periodic {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 0;
            border: 1px solid var(--hairline-strong);
        }
        .element {
            position: relative;
            padding: 1.4rem 1.3rem 1.3rem;
            border-right: 1px solid var(--hairline-strong);
            border-bottom: 1px solid var(--hairline-strong);
            background: var(--paper);
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
            min-height: 230px;
            transition: background-color 280ms ease, color 280ms ease;
            overflow: hidden;
        }
        .element:nth-child(6n) { border-right: 0; }
        .element:last-child { border-right: 0; }
        .element::after {
            content: "";
            position: absolute;
            inset: 0;
            background: var(--navy);
            opacity: 0;
            transition: opacity 280ms ease;
            z-index: 0;
        }
        .element > * { position: relative; z-index: 1; }
        .element:hover { color: var(--paper); }
        .element:hover::after { opacity: 1; }
        .element:hover .element__num,
        .element:hover .element__symbol,
        .element:hover .element__name,
        .element:hover .element__desc,
        .element:hover .element__more { color: var(--paper); }

        .element__num {
            font-family: 'Geist Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 0.12em;
            color: var(--muted);
        }
        .element__symbol {
            font-family: 'Instrument Serif', serif;
            font-weight: 400;
            font-size: 3.2rem;
            line-height: 1;
            letter-spacing: -0.04em;
            color: var(--navy);
            margin: -0.2rem 0 0.5rem;
        }
        .element__symbol em { font-style: italic; color: var(--signal); }
        .element:hover .element__symbol em { color: rgba(217, 231, 243, 1); }
        .element__name {
            font-family: 'Geist', sans-serif;
            font-weight: 600;
            font-size: 0.95rem;
            line-height: 1.25;
            color: var(--navy);
            letter-spacing: -0.005em;
        }
        .element__desc {
            font-family: 'Geist', sans-serif;
            font-size: 0.82rem;
            line-height: 1.5;
            color: var(--ink-soft);
            margin: 0;
        }
        .element__more {
            margin-top: auto;
            font-family: 'Geist Mono', monospace;
            font-size: 0.66rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--signal);
            padding-top: 0.6rem;
        }

        /* ─── ABOUT (pull-quote treatment) ─── */
        .pull {
            display: grid;
            grid-template-columns: 1fr 0.7fr;
            gap: clamp(2.5rem, 6vw, 6rem);
            align-items: center;
        }
        .pull__quote {
            font-family: 'Instrument Serif', serif;
            font-size: clamp(1.8rem, 3.4vw, 2.7rem);
            line-height: 1.18;
            letter-spacing: -0.018em;
            color: var(--navy);
            font-weight: 400;
            margin: 0;
            position: relative;
            max-width: 22ch;
        }
        .pull__quote em { font-style: italic; color: var(--signal); }
        .pull__quote::before {
            content: "❝";
            position: absolute;
            left: -1.2rem;
            top: -1.1rem;
            font-size: 4rem;
            line-height: 1;
            color: var(--signal);
            opacity: 0.45;
            font-style: italic;
        }
        .pull__body {
            margin-top: 1.6rem;
            font-family: 'Geist', sans-serif;
            font-size: 1rem;
            line-height: 1.7;
            color: var(--ink-soft);
            max-width: 36em;
        }
        .pull__cite {
            margin-top: 1.4rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.74rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .pull__image {
            position: relative;
        }
        .pull__image img {
            width: 100%;
            aspect-ratio: 3 / 4;
            object-fit: cover;
            display: block;
            border-radius: var(--radius);
            filter: saturate(0.92) contrast(1.04);
        }
        .pull__image-cap {
            font-family: 'Geist Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--muted);
            margin-top: 0.9rem;
            line-height: 1.5;
        }

        /* ─── BULLETIN SUBSCRIBE (slim strip) ─── */
        .subscribe {
            margin-top: clamp(4rem, 7vw, 6rem);
            border-top: 1px solid var(--navy);
            border-bottom: 1px solid var(--navy);
            padding: clamp(2rem, 4vw, 3.5rem) 0;
        }
        .subscribe__inner {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
            gap: clamp(2rem, 4vw, 4rem);
            align-items: center;
        }
        .subscribe__title {
            font-family: 'Instrument Serif', serif;
            font-weight: 400;
            font-size: clamp(1.7rem, 3vw, 2.3rem);
            line-height: 1.05;
            letter-spacing: -0.022em;
            color: var(--navy);
            margin: 0 0 0.6rem;
            max-width: 14ch;
        }
        .subscribe__title em { font-style: italic; color: var(--signal); }
        .subscribe__body {
            font-family: 'Geist', sans-serif;
            font-size: 0.95rem;
            color: var(--ink-soft);
            margin: 0;
            line-height: 1.55;
            max-width: 38em;
        }
        .subscribe form {
            display: flex;
            gap: 0.55rem;
            align-items: stretch;
        }
        .subscribe input[type="email"] {
            flex: 1;
            min-width: 0;
            background: var(--paper);
            border: 1px solid var(--hairline-strong);
            color: var(--ink);
            padding: 1rem 1.1rem;
            font-size: 16px;
            font-family: 'Geist Mono', monospace;
            letter-spacing: 0.04em;
            border-radius: var(--radius);
            min-height: 56px;
        }
        .subscribe input[type="email"]:focus {
            outline: none;
            border-color: var(--signal);
            box-shadow: 0 0 0 3px rgba(46,125,193,0.18);
        }
        .subscribe input[type="email"]::placeholder { color: var(--muted); }
        .subscribe button {
            background: var(--navy);
            color: var(--paper);
            border: 1px solid var(--navy);
            padding: 0 1.6rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.78rem;
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            border-radius: var(--radius);
            min-height: 56px;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: background 180ms ease;
        }
        .subscribe button:hover { background: var(--navy-hover); }

        /* ─── REVEAL ANIMATIONS ─── */
        .reveal { opacity: 0; transform: translateY(18px); transition: opacity 700ms ease, transform 700ms ease; }
        .reveal.in-view { opacity: 1; transform: translateY(0); }
        .reveal--stagger > * { opacity: 0; transform: translateY(18px); transition: opacity 700ms ease, transform 700ms ease; }
        .reveal--stagger.in-view > * { opacity: 1; transform: translateY(0); }
        .reveal--stagger.in-view > *:nth-child(1) { transition-delay: 60ms; }
        .reveal--stagger.in-view > *:nth-child(2) { transition-delay: 140ms; }
        .reveal--stagger.in-view > *:nth-child(3) { transition-delay: 220ms; }
        .reveal--stagger.in-view > *:nth-child(4) { transition-delay: 300ms; }
        .reveal--stagger.in-view > *:nth-child(5) { transition-delay: 380ms; }
        .reveal--stagger.in-view > *:nth-child(6) { transition-delay: 460ms; }

        @media (prefers-reduced-motion: reduce) {
            .hero-v2 h1 .word { animation: none; opacity: 1; transform: none; }
            .reveal, .reveal--stagger > * { opacity: 1; transform: none; }
        }

        /* ─── RESPONSIVE ─── */
        @media (max-width: 1080px) {
            .periodic { grid-template-columns: repeat(3, 1fr); }
            .element:nth-child(6n) { border-right: 1px solid var(--hairline-strong); }
            .element:nth-child(3n) { border-right: 0; }
        }
        @media (max-width: 960px) {
            .hero-v2__grid { grid-template-columns: 1fr; }
            .field-notes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.4rem 2rem; }
            .pull { grid-template-columns: 1fr; }
            .pull__image { max-width: 380px; }
            .bulletin__item { grid-template-columns: 3rem minmax(0, 1fr); }
            .bulletin__thumb { grid-column: 1 / -1; max-width: 100%; }
            .timeline__grid { grid-template-columns: 1fr; }
            .subscribe__inner { grid-template-columns: 1fr; }
        }
        @media (max-width: 640px) {
            .periodic { grid-template-columns: repeat(2, 1fr); }
            .element:nth-child(3n) { border-right: 1px solid var(--hairline-strong); }
            .element:nth-child(2n) { border-right: 0; }
            .chapter__head { grid-template-columns: 1fr; }
            .chapter__meta { justify-self: start; padding-bottom: 0; }
            .subscribe form { flex-direction: column; }
            .hero-v2 h1 { font-size: clamp(3.2rem, 13vw, 5rem); max-width: none; }
            .dispatch__inner { gap: 0.8rem; }
        }
{% endblock %}

