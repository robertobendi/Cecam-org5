        </div>

        <!-- 23 · About blurb -->
        <a class="pin" href="/about" data-cat="about" data-tags="about">
            <div class="pin__body">
                <div class="pin__top"><span class="pin__tag" data-cat="about"><span class="dot"></span>Mission</span></div>
                <h3 class="pin__title" style="font-size: 1.15rem; font-weight: 700; letter-spacing: -0.02em;">Fundamental research on advanced computational methods.</h3>
                <p class="pin__desc">From atomistic and molecular simulation to materials, biology, medicinal chemistry, multiscale modelling, statistical methods, and machine learning — CECAM curates the program that helps the community keep up.</p>
                <span class="pin__cta">Read the mission <span class="arrow">→</span></span>
            </div>
        </a>

        <!-- 24 · Browse program CTA -->
        <a class="pin" href="/program" data-cat="about" data-tags="about workshop school conference">
            <div class="pin__body">
                <div class="pin__top"><span class="pin__tag" data-cat="about"><span class="dot"></span>Full program</span></div>
                <h3 class="pin__title" style="font-size: 1.15rem; font-weight: 700; letter-spacing: -0.02em;">Browse every CECAM event.</h3>
                <p class="pin__desc">All workshops, schools and conferences across the network — past, present and scheduled. Filter by date, type, or node.</p>
                <span class="pin__cta">Open the program <span class="arrow">→</span></span>
            </div>
        </a>

    </div>
    <p class="empty-state" id="empty-state" hidden>No pins match <strong id="empty-query"></strong>. Try a different word or category.</p>
</section>

<script>
    (function () {
        // live countdown on open-call pins
        function daysUntil(iso) {
            return Math.ceil((new Date(iso + 'T23:59:59Z').getTime() - Date.now()) / 86400000);
        }
        document.querySelectorAll('.pin--call').forEach(function (pin) {
            var iso = pin.dataset.deadline;
            if (!iso) return;
            var d = daysUntil(iso);
            var t = pin.querySelector('.pin__countdown .t');
            if (!t) return;
            if (d > 0)        t.textContent = 'Open · ' + d + ' day' + (d === 1 ? '' : 's') + ' remaining';
            else if (d === 0) t.textContent = 'Closes today';
            else              t.textContent = 'Closed';
        });

        // relative-time chip on events
        function relWhen(iso) {
            var diff = Math.ceil((new Date(iso + 'T00:00:00Z').getTime() - Date.now()) / 86400000);
            if (diff < 0)   return { text: 'Past', cls: '' };
            if (diff < 7)   return { text: 'This week', cls: 'pin__when--soon' };
            if (diff < 14)  return { text: 'Next week', cls: 'pin__when--soon' };
            if (diff < 31)  return { text: 'This month', cls: 'pin__when--near' };
            if (diff < 92)  return { text: 'In ' + Math.round(diff / 30) + ' months', cls: '' };
            if (diff < 366) return { text: 'Later this year', cls: '' };
            var yrs = Math.floor(diff / 365);
            return { text: 'In ' + yrs + ' year' + (yrs === 1 ? '' : 's'), cls: '' };
        }
        document.querySelectorAll('[data-rel]').forEach(function (el) {
            var r = relWhen(el.dataset.rel);
            el.textContent = r.text;
            if (r.cls) el.classList.add(r.cls);
        });

        // filter chips + search
        var chips  = document.querySelectorAll('.chip');
        var pins   = document.querySelectorAll('.pin');
        var search = document.getElementById('board-search');
        var empty  = document.getElementById('empty-state');
        var emptyQ = document.getElementById('empty-query');
        var current = { filter: 'all', query: '' };

        var allChip = document.querySelector('.chip[data-filter="all"] .chip__count');
        if (allChip) allChip.textContent = pins.length;
        chips.forEach(function (c) {
            var f = c.dataset.filter;
            if (f === 'all') return;
            var n = 0;
            pins.forEach(function (p) {
                if ((p.dataset.tags || '').split(' ').indexOf(f) !== -1) n++;
            });
            var el = c.querySelector('.chip__count');
            if (el) el.textContent = n;
        });

        function apply() {
            var visible = 0;
            pins.forEach(function (p) {
                var tags = (p.dataset.tags || '').split(' ');
                var catOK = current.filter === 'all' || tags.indexOf(current.filter) !== -1;
                var qOK   = !current.query || (p.textContent || '').toLowerCase().indexOf(current.query) !== -1;
                var show  = catOK && qOK;
                p.classList.toggle('pin--hidden', !show);
                if (show) visible++;
            });
            if (visible === 0 && current.query) {
                empty.hidden = false;
                emptyQ.textContent = '“' + current.query + '”';
            } else {
                empty.hidden = true;
            }
        }

        chips.forEach(function (c) {
            c.addEventListener('click', function () {
                chips.forEach(function (x) { x.classList.remove('chip--active'); x.setAttribute('aria-selected', 'false'); });
                c.classList.add('chip--active');
                c.setAttribute('aria-selected', 'true');
                current.filter = c.dataset.filter;
                apply();
            });
        });

        if (search) {
            search.addEventListener('input', function () {
                current.query = search.value.toLowerCase().trim();
                apply();
            });
        }

        // staggered fade-in
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            pins.forEach(function (p) { p.classList.add('in-view'); });
            return;
        }
        if (!('IntersectionObserver' in window)) {
            pins.forEach(function (p) { p.classList.add('in-view'); });
            return;
        }
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) {
                    e.target.classList.add('in-view');
                    io.unobserve(e.target);
                }
            });
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0.05 });
        pins.forEach(function (p) { io.observe(p); });
    })();
</script>
{% endblock %}
