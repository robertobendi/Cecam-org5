{% extends '@theme/layout.twig' %}

{% set nav_active = 'home' %}

{% block title %}CECAM — A third way of doing science, since 1969{% endblock %}

{% block styles %}
        /* ─────────────────────────────────────── home (rich pinboard) ─── */

        :root {
            --board:        #F7F3E8;
            --card:         #FFFFFF;
            --line:         rgba(15, 42, 92, 0.08);
            --line-strong:  rgba(15, 42, 92, 0.18);
            --tint:         rgba(15, 42, 92, 0.045);

            --cat-call:        #C8222C;
            --cat-workshop:    #1F6FA8;
            --cat-school:      #3D6B2A;
            --cat-conference:  #6A3C8A;
            --cat-news:        #A75B30;
            --cat-series:      #2A6B53;
            --cat-about:       #0F2A5C;

            --pin-radius:   14px;
            --pin-shadow-h: 0 8px 24px rgba(15,42,92,0.10), 0 2px 6px rgba(15,42,92,0.04);
        }

        body { background: var(--board); }

        /* ─── BRAND HERO with EPFL aerial photo ─── */
        .brand-hero {
            position: relative;
            width: 100%;
            min-height: clamp(440px, 56vw, 600px);
            overflow: hidden;
            isolation: isolate;
        }
        .brand-hero__bg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
            filter: saturate(0.92) contrast(1.04);
            transform: scale(1.04);
            animation: heroDrift 24s ease-in-out infinite alternate;
        }
        @keyframes heroDrift {
            0%   { transform: scale(1.04) translateX(0); }
            100% { transform: scale(1.06) translateX(-1%); }
        }
        .brand-hero__veil {
            position: absolute;
            inset: 0;
            z-index: 1;
            background:
              linear-gradient(180deg, rgba(15,42,92,0.18) 0%, rgba(15,42,92,0.45) 55%, rgba(8,30,71,0.82) 100%),
              linear-gradient(90deg, rgba(8,30,71,0.30) 0%, transparent 55%);
        }
        .brand-hero__content {
            position: relative;
            z-index: 2;
            max-width: var(--container);
            margin: 0 auto;
            padding: clamp(2rem, 5vw, 3.5rem) var(--gutter) clamp(2.2rem, 5vw, 3.5rem);
            min-height: clamp(440px, 56vw, 600px);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            color: var(--paper);
            gap: clamp(0.8rem, 1.4vw, 1.2rem);
        }
        .brand-hero__eyebrow {
            font-family: 'Geist Mono', ui-monospace, monospace;
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: rgba(246, 244, 238, 0.85);
            margin: 0;
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
        }
        .brand-hero__eyebrow .dot {
            width: 6px;
            height: 6px;
            background: var(--cat-call);
            border-radius: 50%;
            box-shadow: 0 0 0 0 rgba(200,34,44,0.55);
            animation: callPulse 2.2s ease-in-out infinite;
        }
        .brand-hero h1 {
            color: var(--paper);
            font-family: 'Geist', sans-serif;
            font-weight: 700;
            font-size: clamp(2.4rem, 6.2vw, 4.6rem);
            line-height: 0.98;
            letter-spacing: -0.038em;
            margin: 0;
            max-width: 18ch;
            text-wrap: balance;
        }
        .brand-hero h1 .accent { color: #FFB39E; }
        .brand-hero__sub {
            color: rgba(246, 244, 238, 0.88);
            font-family: 'Geist', sans-serif;
            font-size: clamp(1rem, 1.3vw, 1.18rem);
            line-height: 1.5;
            margin: 0;
            max-width: 56ch;
            letter-spacing: -0.005em;
        }
        .brand-hero__search {
            position: relative;
            max-width: 540px;
            margin-top: 0.4rem;
        }
        .brand-hero__search input {
            width: 100%;
            background: rgba(255,255,255,0.96);
            border: 1px solid rgba(255,255,255,0.6);
            border-radius: 999px;
            padding: 0.95rem 1.2rem 0.95rem 2.95rem;
            font-family: 'Geist', sans-serif;
            font-size: 1rem;
            color: var(--ink);
            min-height: 54px;
            box-shadow: 0 6px 24px rgba(8, 30, 71, 0.25);
            transition: border-color 180ms ease, box-shadow 180ms ease;
        }
        .brand-hero__search input::placeholder { color: var(--muted); }
        .brand-hero__search input:focus {
            outline: none;
            background: white;
            box-shadow: 0 0 0 4px rgba(255,255,255,0.4), 0 6px 24px rgba(8, 30, 71, 0.3);
        }
        .brand-hero__search svg {
            position: absolute;
            left: 1.1rem;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            color: var(--muted);
            pointer-events: none;
        }
        .brand-hero__stats {
            margin-top: 0.4rem;
            display: flex;
            flex-wrap: wrap;
            gap: 1.6rem 2rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.74rem;
            color: rgba(246, 244, 238, 0.7);
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .brand-hero__stats strong { color: var(--paper); font-weight: 600; }
        .brand-hero__stats .sep { opacity: 0.25; }

        /* ─── STICKY FILTER CHIPS ─── */
        .chips {
            position: sticky;
            top: 72px;
            z-index: 30;
            background: rgba(247, 243, 232, 0.92);
            backdrop-filter: saturate(140%) blur(10px);
            -webkit-backdrop-filter: saturate(140%) blur(10px);
            border-bottom: 1px solid var(--line);
            padding: 0.8rem 0;
        }
        .chips__row {
            max-width: var(--container);
            margin: 0 auto;
            padding: 0 var(--gutter);
            display: flex;
            gap: 0.4rem;
            overflow-x: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
            -webkit-overflow-scrolling: touch;
        }
        .chips__row::-webkit-scrollbar { display: none; }
        .chip {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: transparent;
            border: 1px solid var(--line-strong);
            color: var(--ink-soft);
            font-family: 'Geist', sans-serif;
            font-size: 0.86rem;
            font-weight: 500;
            letter-spacing: -0.005em;
            padding: 0.45rem 0.9rem;
            border-radius: 999px;
            cursor: pointer;
            transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
            white-space: nowrap;
            min-height: 36px;
        }
        .chip:hover { background: rgba(15,42,92,0.04); color: var(--navy); border-color: rgba(15,42,92,0.28); }
        .chip--active { background: var(--navy); color: var(--paper); border-color: var(--navy); }
        .chip--active:hover { background: var(--navy-hover); color: var(--paper); border-color: var(--navy-hover); }
        .chip__count {
            font-family: 'Geist Mono', monospace;
            font-size: 0.7rem;
            opacity: 0.6;
            font-weight: 400;
        }
        .chip--active .chip__count { opacity: 0.78; }

        /* ─── MASONRY PINBOARD ─── */
        .board { padding: 1.4rem 0 clamp(4rem, 7vw, 5rem); }
        .board__grid {
            column-count: 4;
            column-gap: 1.25rem;
            max-width: var(--container);
            margin: 0 auto;
            padding: 0 var(--gutter);
        }
        @media (max-width: 1180px) { .board__grid { column-count: 3; } }
        @media (max-width: 800px)  { .board__grid { column-count: 2; } }
        @media (max-width: 480px)  { .board__grid { column-count: 1; } }

        .pin {
            break-inside: avoid;
            page-break-inside: avoid;
            display: block;
            background: var(--card);
            border: 1px solid var(--line);
            border-left: 3px solid var(--line-strong);
            border-radius: var(--pin-radius);
            margin: 0 0 1.25rem;
            overflow: hidden;
            text-decoration: none;
            color: inherit;
            position: relative;
            transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
                        box-shadow 240ms cubic-bezier(0.22, 1, 0.36, 1),
                        border-color 240ms ease;
            opacity: 0;
            transform: translateY(10px);
        }
        .pin.in-view {
            opacity: 1;
            transform: translateY(0);
            transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1), opacity 520ms ease;
        }
        a.pin:hover {
            transform: translateY(-2px);
            border-color: var(--line-strong);
            box-shadow: var(--pin-shadow-h);
        }
        .pin--hidden { display: none; }

        .pin[data-cat="call"]       { border-left-color: var(--cat-call); }
        .pin[data-cat="workshop"]   { border-left-color: var(--cat-workshop); }
        .pin[data-cat="school"]     { border-left-color: var(--cat-school); }
        .pin[data-cat="conference"] { border-left-color: var(--cat-conference); }
        .pin[data-cat="news"]       { border-left-color: var(--cat-news); }
        .pin[data-cat="series"]     { border-left-color: var(--cat-series); }
        .pin[data-cat="about"]      { border-left-color: var(--cat-about); }

        .pin__body { padding: 1.2rem 1.25rem 1.3rem; display: flex; flex-direction: column; gap: 0.6rem; }
        .pin__top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.6rem;
            flex-wrap: wrap;
        }
        .pin__tag {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: var(--tint);
            color: var(--ink-soft);
            padding: 0.32rem 0.7rem;
            border-radius: 999px;
            font-family: 'Geist', sans-serif;
            font-size: 0.72rem;
            font-weight: 500;
            white-space: nowrap;
        }
        .pin__tag .dot { width: 6px; height: 6px; background: currentColor; border-radius: 50%; flex-shrink: 0; }
        .pin__tag[data-cat="call"]       { color: var(--cat-call); }
        .pin__tag[data-cat="workshop"]   { color: var(--cat-workshop); }
        .pin__tag[data-cat="school"]     { color: var(--cat-school); }
        .pin__tag[data-cat="conference"] { color: var(--cat-conference); }
        .pin__tag[data-cat="news"]       { color: var(--cat-news); }
        .pin__tag[data-cat="series"]     { color: var(--cat-series); }
        .pin__tag[data-cat="about"]      { color: var(--cat-about); }

        .pin__when {
            font-family: 'Geist Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .pin__when--soon { color: var(--cat-call); font-weight: 500; }
        .pin__when--near { color: var(--ink-soft); }

        .pin__title {
            font-family: 'Geist', sans-serif;
            font-weight: 600;
            font-size: 1.05rem;
            line-height: 1.28;
            letter-spacing: -0.012em;
            color: var(--navy);
            margin: 0;
        }
        .pin__desc {
            font-family: 'Geist', sans-serif;
            font-size: 0.9rem;
            line-height: 1.55;
            color: var(--ink-soft);
            margin: 0;
        }
        .pin__meta {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.05em;
            color: var(--muted);
        }
        .pin__meta svg { width: 13px; height: 13px; opacity: 0.7; flex-shrink: 0; }
        .pin__cta {
            margin-top: 0.4rem;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-family: 'Geist', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            color: var(--navy);
        }
        .pin__cta .arrow { transition: transform 200ms ease; }
        a.pin:hover .pin__cta .arrow { transform: translateX(3px); }

        .pin__img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: cover;
            background: var(--paper-warm);
            transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        a.pin .pin__img-wrap { overflow: hidden; background: var(--paper-warm); }
        a.pin:hover .pin__img { transform: scale(1.03); }

        /* ─── PIN VARIANTS ─── */

        .pin--event .pin__date {
            display: flex;
            align-items: baseline;
            gap: 0.6rem;
            margin: 0.25rem 0 0.3rem;
        }
        .pin--event .pin__day {
            font-family: 'Geist', sans-serif;
            font-weight: 700;
            font-size: 2.5rem;
            line-height: 0.95;
            letter-spacing: -0.04em;
            color: var(--navy);
        }
        .pin--event .pin__mon {
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--ink-soft);
        }

        /* open call pin */
        .pin--call .pin__countdown {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: rgba(200, 34, 44, 0.08);
            color: var(--cat-call);
            padding: 0.4rem 0.75rem;
            border-radius: 999px;
            font-family: 'Geist Mono', monospace;
            font-size: 0.74rem;
            font-weight: 500;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            align-self: flex-start;
        }
        .pin--call .pin__countdown .dot {
            width: 6px; height: 6px;
            background: var(--cat-call);
            border-radius: 50%;
            box-shadow: 0 0 0 0 rgba(200,34,44,0.55);
            animation: callPulse 2.2s ease-in-out infinite;
        }
        @keyframes callPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(200,34,44,0.5); }
            50%      { box-shadow: 0 0 0 6px rgba(200,34,44,0); }
        }
        .pin--call .pin__title { font-size: 1.18rem; line-height: 1.25; }
        .pin--call .pin__cta { color: var(--cat-call); }

        /* THIRD WAY featured quote pin */
        .pin--quote {
            background:
              radial-gradient(circle at 80% 10%, rgba(31, 111, 168, 0.18) 0%, transparent 55%),
              radial-gradient(circle at 10% 90%, rgba(200, 34, 44, 0.08) 0%, transparent 55%),
              linear-gradient(180deg, #FFFFFF 0%, #F1ECDF 100%);
        }
        .pin--quote .pin__body { padding: 1.5rem 1.4rem 1.6rem; }
        .pin--quote .pin__quote {
            font-family: 'Geist', sans-serif;
            font-weight: 700;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            line-height: 1.18;
            letter-spacing: -0.025em;
            color: var(--navy);
            margin: 0.3rem 0 0;
        }
        .pin--quote .pin__quote .mark { color: var(--cat-call); font-size: 1.5em; line-height: 0; vertical-align: -0.18em; margin-right: 0.1em; }
        .pin--quote .pin__cite {
            margin-top: 1rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--muted);
        }

        /* numbers pin (functional, not decorative) */
        .pin--numbers .pin__numgrid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.6rem;
            margin-top: 0.3rem;
        }
        .pin--numbers .pin__numgrid > div {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
        }
        .pin--numbers .pin__num {
            font-family: 'Geist', sans-serif;
            font-weight: 700;
            font-size: 1.75rem;
            line-height: 0.95;
            letter-spacing: -0.04em;
            color: var(--navy);
        }
        .pin--numbers .pin__numlabel {
            font-family: 'Geist Mono', monospace;
            font-size: 0.66rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--muted);
            line-height: 1.3;
        }

        /* series pin */
        .pin--series .pin__title { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.02em; }

        /* network map pin */
        .pin--network .pin__map {
            margin: 0.4rem 0 0.2rem;
            background: var(--tint);
            border-radius: 10px;
            padding: 0.75rem 0.6rem;
        }
        .pin--network .pin__map svg { display: block; width: 100%; height: auto; }

        /* image-led pin */
        .pin--image-top .pin__img-wrap { aspect-ratio: 4 / 3; }
        .pin--image-tall .pin__img-wrap { aspect-ratio: 4 / 5; }
        .pin--image-wide .pin__img-wrap { aspect-ratio: 16 / 9; }

        /* anniversary pin — vintage feel */
        .pin--anniversary {
            background:
              linear-gradient(180deg, #FFFFFF 0%, #F4EBD8 100%);
        }
        .pin--anniversary .pin__big50 {
            font-family: 'Geist', sans-serif;
            font-weight: 800;
            font-size: 3.6rem;
            line-height: 0.9;
            letter-spacing: -0.05em;
            color: var(--navy);
            margin: 0.5rem 0 0.4rem;
        }
        .pin--anniversary .pin__big50 .sup {
            font-size: 0.4em;
            vertical-align: 0.45em;
            margin-left: 0.1em;
            color: var(--cat-call);
            font-weight: 700;
        }

        /* prize pin */
        .pin--prize { background: linear-gradient(180deg, #FFFFFF 0%, #FAF1DC 100%); }
        .pin--prize .pin__img-wrap { aspect-ratio: 4 / 3; background: #1a1a1a; }
        .pin--prize .pin__img { object-fit: contain; padding: 0.5rem; }

        /* HQ pin */
        .pin--hq .pin__img-wrap { aspect-ratio: 16 / 10; }

        /* social follow pin */
        .pin--social .pin__sociallist {
            display: flex;
            flex-direction: column;
            gap: 0.45rem;
            margin-top: 0.4rem;
        }
        .pin--social .pin__sociallink {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.7rem 0.85rem;
            background: var(--tint);
            border-radius: 10px;
            font-family: 'Geist', sans-serif;
            font-weight: 500;
            font-size: 0.9rem;
            color: var(--navy);
            text-decoration: none;
            transition: background 180ms ease, transform 180ms ease;
        }
        .pin--social .pin__sociallink:hover { background: rgba(15,42,92,0.08); transform: translateX(2px); }
        .pin--social .pin__sociallink svg { width: 18px; height: 18px; flex-shrink: 0; color: var(--cat-about); }
        .pin--social .pin__sociallink .handle { margin-left: auto; color: var(--muted); font-family: 'Geist Mono', monospace; font-size: 0.78rem; }

        /* newsletter pin */
        .pin--newsletter {
            background: var(--navy);
            border-color: var(--navy);
            border-left-color: var(--paper);
            color: var(--paper);
        }
        .pin--newsletter .pin__title { color: var(--paper); }
        .pin--newsletter .pin__desc  { color: rgba(246,244,238,0.82); }
        .pin--newsletter .pin__tag   { background: rgba(246,244,238,0.10); color: rgba(246,244,238,0.92); }
        .pin--newsletter .pin__form  { margin-top: 0.4rem; display: flex; flex-direction: column; gap: 0.45rem; }
        .pin--newsletter input[type="email"] {
            background: rgba(246,244,238,0.08);
            border: 1px solid rgba(246,244,238,0.18);
            color: var(--paper);
            border-radius: 10px;
            padding: 0.7rem 0.9rem;
            font-family: 'Geist', sans-serif;
            font-size: 0.92rem;
            min-height: 44px;
            width: 100%;
        }
        .pin--newsletter input[type="email"]::placeholder { color: rgba(246,244,238,0.5); }
        .pin--newsletter input[type="email"]:focus {
            outline: none;
            border-color: var(--paper);
            background: rgba(246,244,238,0.14);
        }
        .pin--newsletter button {
            background: var(--paper);
            color: var(--navy);
            border: 0;
            padding: 0.75rem 1rem;
            font-family: 'Geist', sans-serif;
            font-weight: 600;
            font-size: 0.9rem;
            border-radius: 10px;
            cursor: pointer;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            transition: background 180ms ease;
        }
        .pin--newsletter button:hover { background: #fff; }

        .empty-state {
            text-align: center;
            padding: 4rem 1rem;
            color: var(--muted);
            font-family: 'Geist', sans-serif;
            font-size: 0.95rem;
        }
        .empty-state strong { color: var(--navy); font-weight: 600; }

        @media (prefers-reduced-motion: reduce) {
            .pin { opacity: 1; transform: none; }
            a.pin:hover { transform: none; }
            .pin--call .pin__countdown .dot,
            .brand-hero__eyebrow .dot { animation: none; }
            .brand-hero__bg { animation: none; transform: scale(1.04); }
        }

        @media (max-width: 640px) {
            .pin--numbers .pin__numgrid { grid-template-columns: repeat(3, 1fr); gap: 0.4rem; }
            .pin--numbers .pin__num { font-size: 1.4rem; }
            .brand-hero h1 { font-size: clamp(2rem, 8vw, 2.8rem); }
        }
{% endblock %}

{% block content %}
<section class="brand-hero">
    <img class="brand-hero__bg" src="/uploads/epfl-aerial-panorama.jpg" alt="" aria-hidden="true">
    <div class="brand-hero__veil" aria-hidden="true"></div>
    <div class="brand-hero__content">
        <p class="brand-hero__eyebrow"><span class="dot"></span>Live · Flagship 2027–2028 call open</p>
        <h1>A <span class="accent">third way</span> of doing science. Since 1969.</h1>
        <p class="brand-hero__sub">CECAM convenes the workshops, schools and conferences that shape computational atomic and molecular science across Europe — anchored at EPFL Lausanne, federated across 21 nodes from Edinburgh to Tel Aviv.</p>
        <div class="brand-hero__search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="20" y1="20" x2="16.65" y2="16.65"/></svg>
            <input id="board-search" type="search" placeholder="Search events, calls, lectures, topics…" autocomplete="off" spellcheck="false">
        </div>
        <div class="brand-hero__stats">
            <span><strong>21</strong> nodes</span>
            <span class="sep">·</span>
            <span><strong>29</strong> institutions</span>
            <span class="sep">·</span>
            <span><strong>14</strong> countries</span>
            <span class="sep">·</span>
            <span><strong>56</strong> years</span>
        </div>
    </div>
</section>

<div class="chips" role="tablist" aria-label="Filter pins by category">
    <div class="chips__row">
        <button class="chip chip--active" data-filter="all" role="tab" aria-selected="true">All <span class="chip__count">—</span></button>
