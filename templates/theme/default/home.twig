        </div>
        <div class="brand-hero__stats">
            <span><strong>21</strong> nodes</span>
            <span class="sep">·</span>
            <span><strong>29</strong> institutions</span>
            <span class="sep">·</span>
            <span><strong>14</strong> countries</span>
            <span class="sep">·</span>
            <span><strong>56</strong> years</span>
        </div>
    </div>
</section>

