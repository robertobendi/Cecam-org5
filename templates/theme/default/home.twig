{% extends '@theme/layout.twig' %}

{% set nav_active = 'home' %}

{% block title %}CECAM — A European home for atomistic and molecular simulation{% endblock %}

{% block styles %}
        /* ──────────────────────── home ──────────────────────── */
        .hero {
            position: relative;
            padding: clamp(3rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 7rem);
            border-bottom: 1px solid var(--hairline);
            overflow: hidden;
        }
        .hero__grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
            gap: clamp(2rem, 4vw, 4rem);
            align-items: center;
            position: relative;
            z-index: 2;
        }
        .hero__year {
            font-family: 'Geist Mono', monospace;
            font-size: 0.78rem;
            letter-spacing: 0.15em;
            color: var(--muted);
            text-transform: uppercase;
            margin-bottom: 1.5rem;
            display: flex;
            justify-content: space-between;
            border-top: 1px solid var(--hairline);
            padding-top: 1rem;
            max-width: 36rem;
        }
        .hero h1 {
            font-size: clamp(2.7rem, 7.5vw, 5rem);
            line-height: 0.98;
            font-weight: 500;
            letter-spacing: -0.022em;
            margin-bottom: 1.5rem;
            color: var(--navy);
            max-width: 14ch;
        }
        .hero h1 em { font-style: italic; font-weight: 400; color: var(--signal); }
        .hero__sub {
            font-family: 'Instrument Serif', serif;
            font-weight: 400;
            font-size: clamp(1.15rem, 1.6vw, 1.35rem);
            line-height: 1.5;
            color: var(--ink-soft);
            max-width: 38em;
            margin-bottom: 2rem;
        }
        .hero__cta { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
        .hero__mark {
            position: relative;
            justify-self: end;
        }
        .hero__mark img {
            width: 100%;
            max-width: 360px;
            height: auto;
            display: block;
            opacity: 0.94;
        }
        .hero__mark-caption {
            font-family: 'Geist Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--muted);
            margin-top: 1rem;
            text-align: right;
            max-width: 360px;
            margin-left: auto;
        }

        /* Tickers — small stats strip under hero */
        .hero__ticker {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
            margin-top: clamp(3rem, 6vw, 4.5rem);
            padding-top: 2rem;
            border-top: 1px solid var(--hairline);
            position: relative;
            z-index: 2;
        }
        .hero__ticker > div { display: flex; flex-direction: column; gap: 0.4rem; }
        .hero__ticker .num {
            font-family: 'Instrument Serif', serif;
            font-size: clamp(2rem, 3.4vw, 2.75rem);
            font-weight: 500;
            line-height: 1;
            color: var(--navy);
            letter-spacing: -0.02em;
        }
        .hero__ticker .label {
            font-size: 0.825rem;
            color: var(--ink-soft);
            line-height: 1.45;
            max-width: 12em;
        }

        /* Open-call ribbon */
        .ribbon {
            background: var(--navy);
            color: var(--paper);
            padding: clamp(2.5rem, 5vw, 4rem) 0;
            position: relative;
            overflow: hidden;
        }
        .ribbon::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 90% 30%, rgba(46,125,193,0.18) 0%, transparent 55%);
            pointer-events: none;
        }
        .ribbon__grid {
            position: relative;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 3rem;
            align-items: center;
        }
        .ribbon__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.7rem;
            color: var(--paper);
            opacity: 0.95;
            font-size: 0.82rem;
            font-weight: 600;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }
        .ribbon h2 {
            color: var(--paper);
            font-size: clamp(1.6rem, 3vw, 2.25rem);
            line-height: 1.15;
            margin-bottom: 1rem;
            max-width: 24ch;
        }
        .ribbon__deadline {
            font-family: 'Geist Mono', monospace;
            font-size: 0.9rem;
            color: rgba(246, 244, 238, 0.85);
            letter-spacing: 0.04em;
        }
        .ribbon__deadline strong { color: var(--paper); font-weight: 500; }

        /* Section header pattern */
        .sec-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 2rem;
            margin-bottom: 2.5rem;
            border-top: 1px solid var(--navy);
            padding-top: 1.5rem;
        }
        .sec-head__title { flex: 1; }
        .sec-head h2 {
            font-size: clamp(1.8rem, 3.4vw, 2.4rem);
            margin: 0.5rem 0 0;
            max-width: 18ch;
        }
        .sec-head__meta {
            font-family: 'Geist Mono', monospace;
            font-size: 0.78rem;
            letter-spacing: 0.12em;
            color: var(--muted);
            text-transform: uppercase;
            padding-bottom: 0.4rem;
            white-space: nowrap;
        }
        .section { padding: var(--section-y) 0; }
        .section--tight { padding: var(--section-y-sm) 0; }

        /* Featured news grid */
        .news-grid {
            display: grid;
            grid-template-columns: 1.45fr 1fr;
            gap: clamp(1.5rem, 3vw, 2.5rem);
        }
        .news-feature {
            display: flex;
            flex-direction: column;
            text-decoration: none;
            color: inherit;
        }
        .news-feature__img {
            aspect-ratio: 16 / 10;
            background: var(--paper-warm);
            overflow: hidden;
            border: 1px solid var(--hairline);
            position: relative;
        }
        .news-feature__img img,
        .news-feature__img .placeholder {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        .news-feature:hover .news-feature__img img { transform: scale(1.04); }
        .news-feature__img .placeholder {
            display: grid;
            place-items: center;
            background:
              radial-gradient(circle at 30% 30%, rgba(46,125,193,0.18) 0%, transparent 50%),
              radial-gradient(circle at 70% 70%, rgba(15,42,92,0.12) 0%, transparent 55%),
              var(--paper-warm);
            color: var(--navy);
            font-family: 'Instrument Serif', serif;
            font-size: 3rem;
            font-style: italic;
            opacity: 0.7;
        }
        .news-feature__body { padding: 1.5rem 0 0; display: flex; flex-direction: column; gap: 0.75rem; }
        .news-feature__body .meta {
            font-family: 'Geist Mono', monospace;
            font-size: 0.75rem;
            letter-spacing: 0.12em;
            color: var(--muted);
            text-transform: uppercase;
        }
        .news-feature h3 {
            font-family: 'Instrument Serif', serif;
            font-weight: 500;
            font-size: clamp(1.4rem, 2.6vw, 1.95rem);
            line-height: 1.18;
            color: var(--navy);
            margin: 0;
            letter-spacing: -0.01em;
        }
        .news-feature p {
            color: var(--ink-soft);
            font-size: 1rem;
            line-height: 1.55;
            margin: 0;
        }

        .news-side { display: flex; flex-direction: column; gap: 2rem; }
        .news-card {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
            text-decoration: none;
            color: inherit;
            padding-bottom: 2rem;
            border-bottom: 1px solid var(--hairline);
        }
        .news-card:last-child { border-bottom: 0; padding-bottom: 0; }
        .news-card__img {
            aspect-ratio: 16 / 9;
            background: var(--paper-warm);
            overflow: hidden;
            border: 1px solid var(--hairline);
        }
        .news-card__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms ease; }
        .news-card:hover .news-card__img img { transform: scale(1.04); }
        .news-card .meta {
            font-family: 'Geist Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            color: var(--muted);
            text-transform: uppercase;
        }
        .news-card h4 {
            font-family: 'Instrument Serif', serif;
            font-weight: 500;
            font-size: 1.2rem;
            line-height: 1.25;
            color: var(--navy);
            margin: 0.25rem 0 0.4rem;
        }
        .news-card p { font-size: 0.9rem; color: var(--ink-soft); margin: 0; }

        /* Upcoming program — three event cards */
        .event-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
        }
        .event-card {
            background: rgba(255,255,255,0.5);
            border: 1px solid var(--hairline);
            border-radius: var(--radius);
            padding: 1.6rem 1.6rem 1.4rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            text-decoration: none;
            color: inherit;
            min-height: 280px;
            transition: border-color 220ms ease, transform 220ms ease, background 220ms ease;
            position: relative;
        }
        .event-card:hover {
            border-color: var(--hairline-strong);
            background: rgba(255,255,255,0.9);
        }
        .event-card__top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
        }
        .event-card__dates {
            font-family: 'Geist Mono', monospace;
            font-size: 0.78rem;
            letter-spacing: 0.06em;
            color: var(--ink-soft);
            text-align: right;
            line-height: 1.35;
        }
        .event-card__dates strong { display: block; font-size: 1.4rem; font-weight: 500; color: var(--navy); letter-spacing: -0.01em; }
        .event-card h3 {
            font-family: 'Instrument Serif', serif;
            font-weight: 500;
            font-size: 1.35rem;
            line-height: 1.2;
            color: var(--navy);
            margin: 0;
            flex: 1;
            letter-spacing: -0.005em;
        }
        .event-card__venue {
            margin-top: auto;
            font-size: 0.88rem;
            color: var(--ink-soft);
            line-height: 1.5;
            padding-top: 1rem;
            border-top: 1px solid var(--hairline);
        }
        .event-card__venue strong { color: var(--navy); font-weight: 500; }

        /* Activities grid (3x2) */
        .activities-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
        }
        .activity-tile {
            background: rgba(255,255,255,0.45);
            border: 1px solid var(--hairline);
            border-radius: var(--radius);
            padding: 1.5rem 1.5rem 1.5rem;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            gap: 0.9rem;
            min-height: 220px;
            transition: background-color 220ms ease, border-color 220ms ease;
        }
        .activity-tile:hover { background: rgba(46,125,193,0.06); border-color: var(--hairline-strong); }
        .activity-tile__icon {
            width: 36px;
            height: 36px;
            color: var(--signal);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .activity-tile h3 {
            font-family: 'Instrument Serif', serif;
            font-weight: 500;
            font-size: 1.2rem;
            line-height: 1.2;
            color: var(--navy);
            margin: 0;
        }
        .activity-tile p {
            font-size: 0.9rem;
            color: var(--ink-soft);
            margin: 0;
            line-height: 1.5;
        }
        .activity-tile__more {
            margin-top: auto;
            font-size: 0.78rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--signal);
            font-weight: 600;
        }

        /* About-tease */
        .about-tease {
            display: grid;
            grid-template-columns: 1fr 0.85fr;
            gap: clamp(2.5rem, 5vw, 4.5rem);
            align-items: center;
        }
        .about-tease__copy h2 {
            font-size: clamp(1.8rem, 3vw, 2.4rem);
            line-height: 1.15;
            margin-bottom: 1.5rem;
            max-width: 16ch;
        }
        .about-tease__copy p { font-size: 1.05rem; color: var(--ink-soft); line-height: 1.65; max-width: 36em; }
        .about-tease__image {
            position: relative;
        }
        .about-tease__image img {
            width: 100%;
            aspect-ratio: 4 / 5;
            object-fit: cover;
            border-radius: var(--radius);
        }
        .about-tease__caption {
            font-family: 'Geist Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--muted);
            margin-top: 0.85rem;
        }

        /* Newsletter strip */
        .newsletter {
            background: var(--paper-warm);
            padding: var(--section-y-sm) 0;
            border-top: 1px solid var(--hairline);
            border-bottom: 1px solid var(--hairline);
        }
        .newsletter__inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: clamp(2rem, 4vw, 4rem);
            align-items: center;
        }
        .newsletter h2 {
            font-size: clamp(1.6rem, 2.8vw, 2.2rem);
            margin: 0 0 0.75rem;
            max-width: 14ch;
        }
        .newsletter p { color: var(--ink-soft); margin: 0; max-width: 36em; }
        .newsletter form {
            display: flex;
            gap: 0.5rem;
        }
        .newsletter input[type="email"] {
            flex: 1;
            background: var(--paper);
            border: 1px solid var(--hairline-strong);
            color: var(--ink);
            padding: 0.95rem 1.05rem;
            border-radius: var(--radius);
            font-size: 16px;
            font-family: inherit;
            min-height: 52px;
        }
        .newsletter input[type="email"]:focus {
            outline: none;
            border-color: var(--signal);
            box-shadow: 0 0 0 3px rgba(46,125,193,0.18);
        }
        .newsletter button {
            background: var(--navy);
            color: var(--paper);
            border: 1px solid var(--navy);
            padding: 0.95rem 1.4rem;
            border-radius: var(--radius);
            font-size: 0.95rem;
            font-weight: 500;
            min-height: 52px;
            transition: background-color 180ms ease;
        }
        .newsletter button:hover { background: var(--navy-hover); }

        @media (max-width: 980px) {
            .hero__grid { grid-template-columns: 1fr; }
            .hero__mark { justify-self: start; max-width: 240px; }
            .hero__mark-caption { text-align: left; margin-left: 0; max-width: 240px; }
            .hero__ticker { grid-template-columns: repeat(2, 1fr); gap: 1.25rem 2rem; }
            .news-grid { grid-template-columns: 1fr; }
            .event-grid { grid-template-columns: 1fr; }
            .activities-grid { grid-template-columns: repeat(2, 1fr); }
            .about-tease { grid-template-columns: 1fr; }
            .about-tease__image img { aspect-ratio: 3 / 2; }
            .newsletter__inner { grid-template-columns: 1fr; }
            .ribbon__grid { grid-template-columns: 1fr; }
        }
        @media (max-width: 560px) {
            .activities-grid { grid-template-columns: 1fr; }
            .sec-head { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
            .newsletter form { flex-direction: column; }
        }
{% endblock %}

{% block content %}
<section class="hero">
    <div class="container">
        <div class="hero__grid">
            <div class="hero__copy">
                <div class="hero__year">
                    <span>EST. 1969 · LAUSANNE</span>
                    <span>50 YEARS / 22 NODES</span>
                </div>
                <h1>A European home for atomistic and molecular <em>simulation.</em></h1>
                <p class="hero__sub">CECAM convenes the workshops, schools and conferences that shape computational science across Europe — proposed by researchers, funded by the network, hosted at EPFL and partner nodes from Edinburgh to Rome.</p>
                <div class="hero__cta">
                    <a class="btn" href="/program">Browse program <span class="arrow" aria-hidden="true">→</span></a>
                    <a class="btn btn--ghost" href="/about">What is CECAM <span class="arrow" aria-hidden="true">→</span></a>
                </div>
            </div>
            <div class="hero__mark" aria-hidden="true">
                <img src="/uploads/cecam-mark-large.png" alt="" width="360" height="320">
                <p class="hero__mark-caption">Centre Européen de Calcul Atomique et Moléculaire</p>
            </div>
        </div>

        <div class="hero__ticker">
            <div>
                <span class="num">22</span>
                <span class="label">Nodes across Europe and beyond</span>
            </div>
            <div>
                <span class="num">50+</span>
                <span class="label">Years of European computational science, since 1969</span>
            </div>
            <div>
                <span class="num">1969</span>
                <span class="label">Founded in Orsay, anchored at EPFL since 2003</span>
            </div>
            <div>
                <span class="num">∞</span>
                <span class="label">Open peer-led calls — anyone can propose a workshop</span>
            </div>
        </div>
    </div>
</section>

<section class="ribbon" aria-labelledby="ribbon-h">
    <div class="container">
        <div class="ribbon__grid">
            <div>
                <p class="ribbon__eyebrow"><span class="pulse-dot" aria-hidden="true"></span> Open call · Flagship 2027–2028</p>
                <h2 id="ribbon-h">Help us shape the next two years of European computational science.</h2>
                <p class="ribbon__deadline">Propose a workshop, school, or conference in the broad area of simulation and modelling. <strong>Closes 17 July 2026.</strong></p>
            </div>
            <div>
                <a class="btn btn--paper" href="/program#flagship">Submit a proposal <span class="arrow" aria-hidden="true">→</span></a>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="sec-head">
            <div class="sec-head__title">
                <p class="eyebrow eyebrow--bare">News from the network</p>
                <h2>What's happening at CECAM.</h2>
            </div>
            <div class="sec-head__meta">All news <a class="link-arrow" href="/news" style="margin-left: 0.5rem;"><span class="arrow" aria-hidden="true">→</span></a></div>
        </div>

        <div class="news-grid">
            <a class="news-feature" href="/news">
                <div class="news-feature__img">
                    <img src="/uploads/molecular-dynamics.jpg" alt="Molecular dynamics visualization of an amorphous system" loading="lazy">
                </div>
                <div class="news-feature__body">
                    <div class="meta">17 Mar 2026 · CECAM-Lorentz selection</div>
                    <h3>The 2027 CECAM-Lorentz workshop has been selected: <em>Fracture of Amorphous Materials Across the Scales.</em></h3>
                    <p>Congratulations to Maximilian Ries, Sebastian Pfaller and Andrea Giuntoli. The workshop will take place at CECAM-HQ, EPFL, Lausanne on 12–16 April 2027.</p>
                    <span class="link-arrow">Read the announcement <span class="arrow" aria-hidden="true">→</span></span>
                </div>
            </a>

            <div class="news-side">
                <a class="news-card" href="/news">
                    <div class="news-card__img">
                        <img src="/uploads/sem-instrument.jpg" alt="Scanning electron microscope at a research lab" loading="lazy">
                    </div>
                    <div>
                        <div class="meta">02 Feb 2026 · Open call</div>
                        <h4>Flagship 2027–2028 call open until 17 July 2026.</h4>
                        <p>Shape the next two-year program by proposing events in simulation and modelling.</p>
                    </div>
                </a>
                <a class="news-card" href="/news">
                    <div class="news-card__img">
                        <img src="/uploads/protein-structure.png" alt="Protein structure visualization" loading="lazy">
                    </div>
                    <div>
                        <div class="meta">12 Jan 2026 · Event</div>
                        <h4>ESL module integration into electronic-structure codes, 17–28 Feb at CECAM-HQ.</h4>
                        <p>A two-week event for developers of electronic-structure software.</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section" style="padding-top: 0;">
    <div class="container">
        <div class="sec-head">
            <div class="sec-head__title">
                <p class="eyebrow eyebrow--bare">Coming up</p>
                <h2>Next events across the network.</h2>
            </div>
            <div class="sec-head__meta">Full program <a class="link-arrow" href="/program" style="margin-left: 0.5rem;"><span class="arrow" aria-hidden="true">→</span></a></div>
        </div>

        <div class="event-grid">
            <a class="event-card" href="/program">
                <div class="event-card__top">
                    <span class="badge badge--workshop">Workshop</span>
                    <span class="event-card__dates"><strong>26 May</strong>2026</span>
                </div>
                <h3>Deep Learning in Materials Science: Interpretation, Generalisation, and the Risk of Overfitting</h3>
                <div class="event-card__venue">
                    <strong>CECAM-HQ, EPFL, Lausanne</strong><br>
                    A four-day workshop on uncertainty quantification for ML potentials.
                </div>
            </a>

            <a class="event-card" href="/program">
                <div class="event-card__top">
                    <span class="badge badge--school">School</span>
                    <span class="event-card__dates"><strong>14 Sep</strong>2026</span>
                </div>
                <h3>Picking Flowers: Hands-on FLEUR for first-principles simulations</h3>
                <div class="event-card__venue">
                    <strong>Forschungszentrum Jülich</strong><br>
                    Five-day school on the full-potential linearised augmented plane-wave method.
                </div>
            </a>

            <a class="event-card" href="/program">
                <div class="event-card__top">
                    <span class="badge badge--conference">Conference</span>
                    <span class="event-card__dates"><strong>05 Oct</strong>2026</span>
                </div>
                <h3>Psi-k / CECAM research conference: spin-orbit interaction and electronic structure</h3>
                <div class="event-card__venue">
                    <strong>San Sebastián, Spain</strong><br>
                    Recent theoretical and computational developments at the spin-orbit / electronic-structure interface.
                </div>
            </a>
        </div>
    </div>
</section>

<section class="section section--tight">
    <div class="container">
        <div class="sec-head">
            <div class="sec-head__title">
                <p class="eyebrow eyebrow--bare">Recurring activities</p>
                <h2>Six series, year-round.</h2>
            </div>
            <div class="sec-head__meta">All activities <a class="link-arrow" href="/activities" style="margin-left: 0.5rem;"><span class="arrow" aria-hidden="true">→</span></a></div>
        </div>

        <div class="activities-grid">
            <a class="activity-tile" href="/activities#mixed-gen">
                <div class="activity-tile__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h7A2.5 2.5 0 0 1 15 7.5v4A2.5 2.5 0 0 1 12.5 14H8l-3 3v-3H5.5A2.5 2.5 0 0 1 3 11.5v-4Z"/><path d="M21 12.5a2.5 2.5 0 0 0-2.5-2.5H17"/><path d="M21 12.5v4a2.5 2.5 0 0 1-2.5 2.5H16l3 3v-3"/></svg>
