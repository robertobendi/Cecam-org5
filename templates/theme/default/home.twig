{% extends '@theme/layout.twig' %}

{% set nav_active = 'home' %}

{% block title %}CECAM — Browse European computational science{% endblock %}

{% block styles %}
        /* ────────────────────────────────────────────── pinboard ─── */

        :root {
            --board:        #F5F0E5;
            --board-warm:   #EFE7D6;
            --card:         #FFFFFF;
            --tint-blue:    #E1ECF5;
            --tint-green:   #E2EDD5;
            --tint-peach:   #FAE7D2;
            --tint-lilac:   #ECE0F0;
            --tint-rose:    #FAE2DD;
            --tint-yellow:  #F5EAC9;
            --tint-mint:    #DBEEE5;
            --coral:        #E04E2D;
            --coral-dark:   #B33E20;
            --coral-soft:   #FBE3DB;

            --pin-radius:   18px;
            --pin-shadow:   0 1px 2px rgba(15,42,92,0.04), 0 1px 3px rgba(15,42,92,0.06);
            --pin-shadow-h: 0 4px 8px rgba(15,42,92,0.06), 0 16px 32px rgba(15,42,92,0.14);
        }

        body { background: var(--board); }

        /* ─── HERO GREETING ─── */
        .board-hero {
            padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(1.5rem, 3vw, 2.5rem);
            text-align: center;
        }
        .board-hero__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            font-family: 'Geist Mono', ui-monospace, monospace;
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--coral);
            margin: 0 0 1.2rem;
        }
        .board-hero__eyebrow::before,
        .board-hero__eyebrow::after {
            content: "";
            width: 1.6rem;
            height: 1px;
            background: var(--coral);
            opacity: 0.6;
        }
        .board-hero h1 {
            font-family: 'Geist', sans-serif;
            font-weight: 800;
            font-size: clamp(2.8rem, 8.5vw, 6.5rem);
            line-height: 0.96;
            letter-spacing: -0.045em;
            color: var(--navy);
            margin: 0 auto 1.2rem;
            max-width: 18ch;
        }
        .board-hero h1 .accent {
            color: var(--coral);
            display: inline-block;
            position: relative;
        }
        .board-hero h1 .accent::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0.1em;
            height: 0.18em;
            background: var(--coral);
            opacity: 0.18;
            border-radius: 999px;
            z-index: -1;
        }
        .board-hero__sub {
            font-family: 'Geist', sans-serif;
            font-size: clamp(1.05rem, 1.4vw, 1.2rem);
            line-height: 1.55;
            color: var(--ink-soft);
            max-width: 38em;
            margin: 0 auto 2rem;
            letter-spacing: -0.005em;
        }
        .board-hero__count {
            font-family: 'Geist Mono', monospace;
            font-size: 0.74rem;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }
        .board-hero__count strong { color: var(--navy); font-weight: 600; }

        /* ─── STICKY FILTER CHIPS ─── */
        .chips {
            position: sticky;
            top: 72px;
            z-index: 30;
            background: rgba(245, 240, 229, 0.92);
            backdrop-filter: saturate(140%) blur(10px);
            -webkit-backdrop-filter: saturate(140%) blur(10px);
            border-bottom: 1px solid rgba(15,42,92,0.05);
            padding: 0.85rem 0;
        }
        .chips__row {
            max-width: var(--container);
            margin: 0 auto;
            padding: 0 var(--gutter);
            display: flex;
            gap: 0.55rem;
            overflow-x: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
            scroll-padding: 1rem;
            -webkit-overflow-scrolling: touch;
        }
        .chips__row::-webkit-scrollbar { display: none; }
        .chip {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            background: transparent;
            border: 1px solid transparent;
            color: var(--ink-soft);
            font-family: 'Geist', sans-serif;
            font-size: 0.92rem;
            font-weight: 500;
            letter-spacing: -0.005em;
            padding: 0.55rem 1rem;
            border-radius: 999px;
            cursor: pointer;
            transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
            white-space: nowrap;
            min-height: 40px;
        }
        .chip:hover { background: rgba(15,42,92,0.06); color: var(--navy); }
        .chip--active {
            background: var(--navy);
            color: var(--paper);
            border-color: var(--navy);
        }
        .chip--active:hover { background: var(--navy-hover); color: var(--paper); }
        .chip__count {
            font-family: 'Geist Mono', monospace;
            font-size: 0.72rem;
            opacity: 0.65;
            font-weight: 400;
        }
        .chip--active .chip__count { opacity: 0.78; }

        /* ─── MASONRY PINBOARD ─── */
        .board {
            padding: 1.5rem 0 clamp(4rem, 8vw, 6rem);
        }
        .board__grid {
            column-count: 4;
            column-gap: 1rem;
            max-width: var(--container);
            margin: 0 auto;
            padding: 0 var(--gutter);
        }
        @media (max-width: 1280px) { .board__grid { column-count: 4; } }
        @media (max-width: 1080px) { .board__grid { column-count: 3; } }
        @media (max-width: 740px)  { .board__grid { column-count: 2; } }
        @media (max-width: 460px)  { .board__grid { column-count: 1; } }

        .pin {
            break-inside: avoid;
            page-break-inside: avoid;
            display: block;
            background: var(--card);
            border-radius: var(--pin-radius);
            margin: 0 0 1rem;
            overflow: hidden;
            text-decoration: none;
            color: inherit;
            box-shadow: var(--pin-shadow);
            position: relative;
            transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
                        box-shadow 280ms cubic-bezier(0.22, 1, 0.36, 1);
            opacity: 0;
            transform: translateY(14px);
        }
        .pin.in-view {
            opacity: 1;
            transform: translateY(0);
            transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1),
                        box-shadow 280ms cubic-bezier(0.22, 1, 0.36, 1),
                        opacity 600ms ease;
        }
        a.pin:hover {
            transform: translateY(-4px);
            box-shadow: var(--pin-shadow-h);
        }
        .pin--hidden { display: none; }

        /* hover save button */
        .pin__save {
            position: absolute;
            top: 0.75rem;
            right: 0.75rem;
            z-index: 5;
            width: 38px;
            height: 38px;
            background: rgba(255,255,255,0.96);
            border: none;
            border-radius: 999px;
            color: var(--navy);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(15,42,92,0.18);
            opacity: 0;
            transform: translateY(-4px);
            transition: opacity 180ms ease, transform 180ms ease, background 180ms ease, color 180ms ease;
        }
        .pin:hover .pin__save,
        .pin:focus-within .pin__save { opacity: 1; transform: translateY(0); }
        .pin__save:hover { background: var(--coral); color: white; }
        .pin__save svg { width: 18px; height: 18px; display: block; }
        .pin__save--saved {
            background: var(--coral);
            color: white;
            animation: pop 600ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        .pin__save--saved svg path { fill: currentColor; }
        @keyframes pop {
            0%   { transform: scale(1); }
            40%  { transform: scale(1.22); }
            100% { transform: scale(1); }
        }

        /* shared pin internals */
        .pin__img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: cover;
            transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        a.pin:hover .pin__img { transform: scale(1.03); }
        .pin__body { padding: 1.1rem 1.15rem 1.2rem; display: flex; flex-direction: column; gap: 0.55rem; }
        .pin__tag {
            align-self: flex-start;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.66rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0.35rem 0.7rem;
            border-radius: 999px;
            color: var(--navy);
            background: var(--tint-blue);
        }
        .pin__tag--workshop   { background: var(--tint-blue);   color: #1F4D8A; }
        .pin__tag--school     { background: var(--tint-green);  color: #3D6B2A; }
        .pin__tag--conference { background: var(--tint-lilac);  color: #5B3A8A; }
        .pin__tag--lecture    { background: var(--tint-yellow); color: #8A6B1A; }
        .pin__tag--news       { background: var(--tint-rose);   color: #8A3520; }
        .pin__tag--call       { background: var(--coral-soft);  color: var(--coral-dark); }
        .pin__tag--activity   { background: var(--tint-mint);   color: #2A6B53; }
        .pin__tag--about      { background: var(--tint-peach);  color: #7A4A1F; }

        .pin__title {
            font-family: 'Geist', sans-serif;
            font-weight: 600;
            font-size: 1.05rem;
            line-height: 1.28;
            letter-spacing: -0.012em;
            color: var(--navy);
            margin: 0;
        }
        .pin__meta {
            font-family: 'Geist Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .pin__desc {
            font-family: 'Geist', sans-serif;
            font-size: 0.88rem;
            line-height: 1.55;
            color: var(--ink-soft);
            margin: 0;
        }
        .pin__cta {
            margin-top: 0.4rem;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-family: 'Geist', sans-serif;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--coral);
            letter-spacing: -0.005em;
        }
        .pin__cta .arrow { transition: transform 200ms ease; }
        a.pin:hover .pin__cta .arrow { transform: translateX(3px); }

        /* image pin with overlay date */
        .pin__image-wrap { position: relative; overflow: hidden; background: var(--paper-warm); }
        .pin__date-chip {
            position: absolute;
            left: 0.75rem;
            bottom: 0.75rem;
            background: rgba(255,255,255,0.96);
            color: var(--navy);
            font-family: 'Geist', sans-serif;
            padding: 0.4rem 0.65rem 0.45rem;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(15,42,92,0.14);
            display: flex;
            flex-direction: column;
            align-items: center;
            line-height: 1;
            min-width: 48px;
        }
        .pin__date-chip .d { font-weight: 700; font-size: 1.15rem; letter-spacing: -0.02em; }
        .pin__date-chip .m {
            font-family: 'Geist Mono', monospace;
            font-size: 0.62rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--muted);
            margin-top: 0.18rem;
        }

        /* ─── PIN VARIANTS ─── */
        .pin--blue   { background: var(--tint-blue); }
        .pin--green  { background: var(--tint-green); }
        .pin--peach  { background: var(--tint-peach); }
        .pin--lilac  { background: var(--tint-lilac); }
        .pin--rose   { background: var(--tint-rose); }
        .pin--yellow { background: var(--tint-yellow); }
        .pin--mint   { background: var(--tint-mint); }
        .pin--coral  { background: var(--coral); color: white; }
        .pin--coral .pin__title { color: white; }
        .pin--coral .pin__desc  { color: rgba(255,255,255,0.92); }
        .pin--coral .pin__meta  { color: rgba(255,255,255,0.85); }
        .pin--coral .pin__tag   { background: rgba(255,255,255,0.16); color: white; }
        .pin--coral .pin__cta   { color: white; }
        .pin--navy   { background: var(--navy); color: white; }
        .pin--navy .pin__title { color: white; }
        .pin--navy .pin__desc  { color: rgba(255,255,255,0.85); }
        .pin--navy .pin__meta  { color: rgba(255,255,255,0.65); }
        .pin--navy .pin__tag   { background: rgba(255,255,255,0.14); color: white; }
        .pin--navy .pin__cta   { color: #FFB39E; }

        /* big number stat pin */
        .pin--stat .pin__num {
            font-family: 'Geist', sans-serif;
            font-weight: 800;
            font-size: clamp(3.5rem, 7vw, 5.5rem);
            line-height: 0.9;
            letter-spacing: -0.06em;
            color: var(--navy);
            margin: 0.5rem 0 0.6rem;
        }
        .pin--coral.pin--stat .pin__num,
        .pin--navy.pin--stat .pin__num { color: white; }

        /* quote pin */
        .pin--quote .pin__quote {
            font-family: 'Geist', sans-serif;
            font-weight: 600;
            font-size: 1.15rem;
            line-height: 1.35;
            letter-spacing: -0.015em;
            color: var(--navy);
            margin: 0;
        }
        .pin--quote .pin__quote::before { content: "“"; color: var(--coral); margin-right: 0.05em; }
        .pin--quote .pin__quote::after  { content: "”"; color: var(--coral); margin-left: 0.05em; }
        .pin--quote .pin__cite {
            margin-top: 0.8rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--muted);
        }

        /* event pin */
        .pin--event .pin__big-date {
            display: flex;
            align-items: baseline;
            gap: 0.55rem;
            margin: 0.3rem 0 0.5rem;
        }
        .pin--event .pin__big-day {
            font-family: 'Geist', sans-serif;
            font-weight: 800;
            font-size: 2.6rem;
            line-height: 0.9;
            letter-spacing: -0.04em;
            color: var(--navy);
        }
        .pin--event .pin__big-mon {
            font-family: 'Geist', sans-serif;
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--ink-soft);
        }
        .pin--event .pin__venue {
            margin-top: 0.5rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .pin--event .pin__venue strong {
            color: var(--navy);
            font-weight: 500;
            display: block;
        }

        /* headline pin */
        .pin--headline .pin__headline {
            font-family: 'Geist', sans-serif;
            font-weight: 800;
            font-size: clamp(1.6rem, 2.4vw, 2.1rem);
            line-height: 0.98;
            letter-spacing: -0.035em;
            color: var(--navy);
            margin: 0.3rem 0 0.8rem;
        }
        .pin--coral.pin--headline .pin__headline,
        .pin--navy.pin--headline .pin__headline { color: white; }

        /* image-only decorative pin */
        .pin--image-only { padding: 0; }
        .pin--image-only .pin__caption {
            padding: 0.85rem 1.1rem 1rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--muted);
        }

        /* newsletter pin */
        .pin--news-form .pin__form {
            margin-top: 0.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.45rem;
        }
        .pin--news-form input[type="email"] {
            background: white;
            border: 1px solid rgba(15,42,92,0.14);
            border-radius: 12px;
            padding: 0.7rem 0.85rem;
            font-family: 'Geist', sans-serif;
            font-size: 0.9rem;
            color: var(--ink);
            min-height: 44px;
            width: 100%;
        }
        .pin--news-form input[type="email"]:focus {
            outline: none;
            border-color: var(--coral);
            box-shadow: 0 0 0 3px rgba(224,78,45,0.16);
        }
        .pin--news-form button {
            background: var(--navy);
            color: white;
            border: 0;
            padding: 0.75rem 1rem;
            font-family: 'Geist', sans-serif;
            font-weight: 600;
            font-size: 0.9rem;
            border-radius: 12px;
            cursor: pointer;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            transition: background 180ms ease;
        }
        .pin--news-form button:hover { background: var(--navy-hover); }

        /* live pulse on urgent pin */
        .pin__live {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            font-family: 'Geist Mono', monospace;
            font-size: 0.66rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: white;
            background: rgba(255,255,255,0.18);
            padding: 0.3rem 0.65rem;
            border-radius: 999px;
            align-self: flex-start;
        }
        .pin__live .dot {
            width: 6px; height: 6px; background: white; border-radius: 50%;
            box-shadow: 0 0 0 0 rgba(255,255,255,0.55);
            animation: livePulse 2s ease-in-out infinite;
        }
        @keyframes livePulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255,255,255,0.7); opacity: 1; }
            50%      { box-shadow: 0 0 0 6px rgba(255,255,255,0); opacity: 0.75; }
        }

        @media (prefers-reduced-motion: reduce) {
            .pin { opacity: 1; transform: none; }
            a.pin:hover { transform: none; }
            a.pin:hover .pin__img { transform: none; }
            .pin__live .dot { animation: none; }
        }
{% endblock %}

{% block content %}
<section class="board-hero">
    <div class="container">
        <p class="board-hero__eyebrow">Lausanne · Est. 1969</p>
        <h1>What&rsquo;s happening in <span class="accent">European simulation</span>?</h1>
        <p class="board-hero__sub">Workshops, schools, conferences and lectures across the CECAM network — 22 nodes from Edinburgh to Rome, anchored at EPFL.</p>
        <p class="board-hero__count">Browsing <strong>24 pins</strong> · Updated weekly</p>
    </div>
</section>

<div class="chips" role="tablist" aria-label="Filter pins by category">
    <div class="chips__row">
        <button class="chip chip--active" data-filter="all" role="tab" aria-selected="true">All <span class="chip__count">24</span></button>
        <button class="chip" data-filter="call" role="tab" aria-selected="false">Open calls <span class="chip__count">2</span></button>
        <button class="chip" data-filter="workshop" role="tab" aria-selected="false">Workshops <span class="chip__count">1</span></button>
        <button class="chip" data-filter="school" role="tab" aria-selected="false">Schools <span class="chip__count">1</span></button>
        <button class="chip" data-filter="conference" role="tab" aria-selected="false">Conferences <span class="chip__count">1</span></button>
        <button class="chip" data-filter="news" role="tab" aria-selected="false">News <span class="chip__count">4</span></button>
        <button class="chip" data-filter="activity" role="tab" aria-selected="false">Activities <span class="chip__count">6</span></button>
        <button class="chip" data-filter="about" role="tab" aria-selected="false">About <span class="chip__count">9</span></button>
    </div>
</div>

<section class="board">
    <div class="board__grid" id="pinboard">

        <a class="pin pin--coral pin--headline" href="/program#flagship" data-tags="call news">
            <button class="pin__save" type="button" aria-label="Save pin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg></button>
            <div class="pin__body">
                <span class="pin__live"><span class="dot"></span> Open now</span>
                <span class="pin__tag pin__tag--call">Flagship · 2027–2028</span>
                <h3 class="pin__headline">Help us shape the next two years of European science.</h3>
                <p class="pin__desc">Propose a workshop, school, or conference in the broad area of simulation and modelling.</p>
                <span class="pin__meta">Closes 17 July 2026</span>
                <span class="pin__cta">Submit a proposal <span class="arrow">→</span></span>
            </div>
        </a>

        <a class="pin" href="/program" data-tags="workshop">
            <button class="pin__save" type="button" aria-label="Save pin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg></button>
            <div class="pin__image-wrap">
                <img class="pin__img" src="/uploads/molecular-dynamics.jpg" alt="Molecular dynamics visualization" loading="lazy" style="aspect-ratio: 4/5;">
                <div class="pin__date-chip"><span class="d">26</span><span class="m">May</span></div>
            </div>
            <div class="pin__body">
                <span class="pin__tag pin__tag--workshop">Workshop</span>
                <h3 class="pin__title">Deep Learning in Materials Science: Interpretation, Generalisation, and the Risk of Overfitting</h3>
                <p class="pin__desc">A four-day workshop on uncertainty quantification for ML potentials.</p>
                <span class="pin__meta">CECAM-HQ · EPFL · Lausanne</span>
            </div>
        </a>

        <div class="pin pin--blue pin--stat" data-tags="about">
            <div class="pin__body">
                <span class="pin__tag pin__tag--about">Network</span>
                <span class="pin__num">22</span>
                <p class="pin__title">European nodes — and beyond.</p>
                <p class="pin__desc">From Edinburgh to Rome, anchored at EPFL since 2003.</p>
            </div>
        </div>

        <a class="pin" href="/news" data-tags="news">
            <button class="pin__save" type="button" aria-label="Save pin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg></button>
            <div class="pin__image-wrap">
                <img class="pin__img" src="/uploads/sem-instrument.jpg" alt="Scanning electron microscope" loading="lazy" style="aspect-ratio: 1/1;">
            </div>
            <div class="pin__body">
                <span class="pin__tag pin__tag--news">CECAM-Lorentz</span>
                <h3 class="pin__title">2027 CECAM-Lorentz workshop selected: Fracture of Amorphous Materials Across the Scales.</h3>
                <span class="pin__meta">17 Mar 2026 · 12–16 April 2027</span>
            </div>
        </a>

        <a class="pin pin--mint" href="/activities#mixed-gen" data-tags="activity">
