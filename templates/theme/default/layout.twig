<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ site.name }} — Centre Européen de Calcul Atomique et Moléculaire{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}CECAM convenes the workshops, schools and conferences that shape computational atomic and molecular science across Europe — proposed by researchers, funded by the network, hosted at EPFL and partner institutions from Edinburgh to Rome.{% endblock %}">
    <meta name="theme-color" content="#0F2A5C">
    <link rel="icon" href="/uploads/cecam-mark.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy:        #0F2A5C;
            --navy-deep:   #081E47;
            --navy-hover:  #15366E;
            --signal:      #1F6FA8;
            --signal-bright: #2E7DC1;
            --signal-soft: #d9e7f3;
            --pulse:       #C8222C;
            --pulse-soft:  #f4dcdc;
            --paper:       #F6F4EE;
            --paper-warm:  #EEEBE1;
            --ink:         #1A1A1A;
            --ink-soft:    #3a3a3a;
            --muted:       #6b6b6b;
            --hairline:    rgba(15, 42, 92, 0.14);
            --hairline-strong: rgba(15, 42, 92, 0.28);

            --container: 1240px;
            --prose:     760px;

            --gutter:    clamp(1.25rem, 4vw, 2.25rem);
            --section-y: clamp(4rem, 9vw, 7rem);
            --section-y-sm: clamp(2.5rem, 6vw, 4rem);
            --radius:    2px;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
        html, body { margin: 0; padding: 0; }
        body {
            font-family: 'Geist', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
            font-feature-settings: 'ss01', 'cv11';
            background: var(--paper);
            color: var(--ink);
            line-height: 1.55;
            font-size: 17px;
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
            overflow-x: hidden;
        }
        ::selection { background: var(--navy); color: var(--paper); }

        h1, h2, h3, h4 {
            font-family: 'Geist', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 1.02;
            color: var(--navy);
            margin: 0;
        }
        h1 { font-size: clamp(2.8rem, 6.2vw, 4.25rem); }
        h2 { font-size: clamp(2.1rem, 4vw, 2.9rem); line-height: 1.06; }
        h3 { font-family: 'Geist', sans-serif; font-weight: 600; font-size: 1.25rem; line-height: 1.3; letter-spacing: -0.015em; color: var(--ink); }
        h4 { font-family: 'Geist', sans-serif; font-weight: 600; font-size: 1rem; letter-spacing: -0.005em; color: var(--ink); }

        p, ul, ol, blockquote { margin: 0 0 1.1em; }
        a { color: var(--signal); text-decoration: none; }
        a:hover { color: var(--navy); }
        a:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; border-radius: 2px; }

        img { max-width: 100%; height: auto; display: block; }
        button { font: inherit; cursor: pointer; }

        hr { border: 0; border-top: 1px solid var(--hairline); margin: 3rem 0; }
        code { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 0.92em; background: rgba(46,125,193,0.12); padding: 0.1em 0.35em; border-radius: 3px; color: var(--navy); }
        pre  { background: var(--navy); color: var(--paper); padding: 1.25rem 1.5rem; border-radius: 4px; overflow-x: auto; font-size: 0.92em; line-height: 1.55; }
        pre code { background: transparent; color: inherit; padding: 0; }

        .container { max-width: var(--container); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
        .prose { max-width: var(--prose); }
        .wrap  { max-width: var(--prose); margin: 0 auto; padding: 0 var(--gutter); }

        .eyebrow {
            font-family: 'Geist', sans-serif;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--signal);
            display: inline-flex;
            align-items: center;
            gap: 0.6em;
        }
        .eyebrow--ink { color: var(--ink-soft); }
        .eyebrow--paper { color: var(--paper); opacity: 0.85; }
        .eyebrow::before {
            content: "";
            display: inline-block;
            width: 1.5em;
            height: 1px;
            background: currentColor;
            opacity: 0.6;
        }
        .eyebrow--bare::before { display: none; }

        .lede {
            font-family: 'Geist', sans-serif;
            font-weight: 400;
            font-size: clamp(1.15rem, 1.6vw, 1.4rem);
            line-height: 1.5;
            letter-spacing: -0.01em;
            color: var(--ink-soft);
            max-width: 38em;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.6em;
            background: var(--navy);
            color: var(--paper);
            padding: 0.85rem 1.4rem;
            border-radius: var(--radius);
            font-weight: 500;
            font-size: 0.95rem;
            letter-spacing: 0;
            border: 1px solid var(--navy);
            transition: background-color 180ms ease, transform 180ms ease;
            min-height: 44px;
            text-decoration: none;
        }
        .btn:hover { background: var(--navy-hover); color: var(--paper); }
        .btn:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
        .btn .arrow { transition: transform 180ms ease; }
        .btn:hover .arrow { transform: translateX(3px); }

        .btn--ghost {
            background: transparent;
            color: var(--navy);
            border-color: transparent;
            padding-left: 0.25rem;
            padding-right: 0.25rem;
        }
        .btn--ghost:hover { background: transparent; color: var(--navy-hover); }
        .btn--ghost .arrow { transition: transform 180ms ease; }
        .btn--ghost:hover .arrow { transform: translateX(4px); }

        .btn--paper {
            background: var(--paper);
            color: var(--navy);
            border-color: var(--paper);
        }
        .btn--paper:hover { background: #fff; color: var(--navy); }

        .link-arrow {
            display: inline-flex;
            align-items: center;
            gap: 0.45em;
            color: var(--signal);
            font-weight: 500;
            font-size: 0.95rem;
            border-bottom: 1px solid transparent;
            padding-bottom: 1px;
            transition: border-color 180ms ease, color 180ms ease;
        }
        .link-arrow:hover { color: var(--navy); border-bottom-color: var(--navy); }
        .link-arrow .arrow { transition: transform 180ms ease; }
        .link-arrow:hover .arrow { transform: translateX(3px); }

        /* ──────────────────────────────────────────────────────────── header */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 50;
            background: rgba(246, 244, 238, 0.92);
            backdrop-filter: saturate(140%) blur(8px);
            -webkit-backdrop-filter: saturate(140%) blur(8px);
            border-bottom: 1px solid var(--hairline);
        }
        .site-header__inner {
            max-width: var(--container);
            margin: 0 auto;
            padding: 0.85rem var(--gutter);
            min-height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
        }
        .brand {
            display: inline-flex;
            align-items: center;
            text-decoration: none;
            line-height: 0;
        }
        .brand img {
            height: 42px;
            width: auto;
            display: block;
        }
        .primary-nav {
            display: flex;
            align-items: center;
            gap: 2rem;
        }
        .primary-nav a {
            color: var(--navy);
            font-weight: 500;
            font-size: 0.95rem;
            letter-spacing: 0.005em;
            position: relative;
            padding: 0.5rem 0;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
        }
        .primary-nav a::after {
            content: "";
            position: absolute;
            left: 0;
            right: 100%;
            bottom: 14px;
            height: 1px;
            background: var(--navy);
            transition: right 220ms ease;
        }
        .primary-nav a:hover::after,
        .primary-nav a[aria-current="page"]::after { right: 0; }
        .primary-nav .nav-cta {
            background: var(--navy);
            color: var(--paper);
            padding: 0.6rem 1.05rem;
            border-radius: var(--radius);
            font-size: 0.875rem;
        }
        .primary-nav .nav-cta::after { display: none; }
        .primary-nav .nav-cta:hover { background: var(--navy-hover); color: var(--paper); }

        .menu-toggle {
            display: none;
            border: 1px solid var(--hairline-strong);
            background: transparent;
            color: var(--navy);
            border-radius: var(--radius);
            padding: 0.55rem 0.85rem;
            font-weight: 500;
            font-size: 0.875rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            min-height: 44px;
            align-items: center;
            gap: 0.5em;
        }
        .menu-toggle__bars { display: inline-flex; flex-direction: column; gap: 4px; }
        .menu-toggle__bars span { display: block; width: 18px; height: 1.5px; background: var(--navy); }

        /* ──────────────────────────────────────────────────────── footer */
        .site-footer {
            background: var(--navy);
            color: var(--paper);
            margin-top: var(--section-y);
        }
        .site-footer a { color: var(--paper); opacity: 0.85; }
        .site-footer a:hover { opacity: 1; color: #fff; }
        .footer-grid {
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr;
            gap: 3.5rem;
            padding: var(--section-y-sm) 0;
            border-bottom: 1px solid rgba(246, 244, 238, 0.14);
        }
        .footer-col h4 {
            font-family: 'Geist', sans-serif;
            color: var(--paper);
            opacity: 0.6;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            margin: 0 0 1.2rem;
        }
        .footer-col p, .footer-col address {
            font-size: 0.95rem;
            line-height: 1.65;
            font-style: normal;
            opacity: 0.9;
            margin: 0 0 0.5rem;
        }
        .footer-col ul { list-style: none; padding: 0; margin: 0; }
        .footer-col li { margin-bottom: 0.5rem; font-size: 0.95rem; }
        .footer-wordmark {
            background: var(--paper);
            padding: 1rem 1.25rem;
            border-radius: var(--radius);
            display: inline-block;
            margin-bottom: 1.25rem;
        }
        .footer-wordmark img { height: 38px; width: auto; }
        .footer-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 0 2rem;
            font-size: 0.825rem;
            color: rgba(246, 244, 238, 0.7);
        }
        .footer-meta ul { display: flex; gap: 1.25rem; list-style: none; padding: 0; margin: 0; flex-wrap: wrap; }
        .footer-mailing form {
            display: flex;
            gap: 0.4rem;
            margin-top: 0.4rem;
        }
        .footer-mailing input[type="email"] {
            flex: 1;
            min-width: 0;
            background: rgba(246, 244, 238, 0.08);
            border: 1px solid rgba(246, 244, 238, 0.2);
            color: var(--paper);
            padding: 0.7rem 0.9rem;
            border-radius: var(--radius);
            font-size: 16px;
            font-family: inherit;
            min-height: 44px;
        }
        .footer-mailing input[type="email"]::placeholder { color: rgba(246, 244, 238, 0.55); }
        .footer-mailing input[type="email"]:focus {
            outline: none;
            border-color: var(--signal);
            background: rgba(246, 244, 238, 0.14);
        }
        .footer-mailing button {
            background: var(--paper);
            color: var(--navy);
            border: 1px solid var(--paper);
            border-radius: var(--radius);
            padding: 0.7rem 1rem;
            font-weight: 500;
            font-size: 0.875rem;
            min-height: 44px;
            transition: background 180ms ease;
        }
        .footer-mailing button:hover { background: #fff; }

        /* ──────────────────────────────────────────────────────── utilities */
        .vh { position: absolute !important; clip: rect(1px,1px,1px,1px); overflow: hidden; height: 1px; width: 1px; padding: 0; margin: -1px; border: 0; white-space: nowrap; }
        .text-mono { font-family: 'Geist Mono', ui-monospace, monospace; font-feature-settings: "tnum" on; }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 0.45em;
            border: 1px solid var(--hairline-strong);
            color: var(--navy);
            background: rgba(246, 244, 238, 0.7);
            border-radius: 999px;
            padding: 0.35em 0.85em;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .badge--workshop { color: #1d4d8a; border-color: rgba(46,125,193,0.4); background: var(--signal-soft); }
        .badge--school   { color: #2a4f1f; border-color: rgba(80,140,60,0.4); background: #e6efe2; }
        .badge--conference { color: var(--navy); border-color: var(--hairline-strong); background: var(--paper-warm); }
        .badge--event    { color: #5a3a08; border-color: rgba(170,110,30,0.35); background: #f4ead8; }
        .badge--open     { color: var(--pulse); border-color: rgba(200,34,44,0.35); background: var(--pulse-soft); }

        .pulse-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--pulse);
            box-shadow: 0 0 0 0 rgba(200,34,44,0.55);
            animation: pulse 2.2s ease-in-out infinite;
        }
        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(200,34,44,0.6); opacity: 1; }
            50% { box-shadow: 0 0 0 8px rgba(200,34,44,0); opacity: 0.7; }
        }

        @media (prefers-reduced-motion: reduce) {
            .pulse-dot { animation: none; }
            *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; scroll-behavior: auto !important; }
        }

        /* ──────────────────────────────────────────────────────── mobile */
        @media (max-width: 880px) {
            .menu-toggle { display: inline-flex; }
            .primary-nav {
                position: fixed;
                inset: 72px 0 0 0;
                background: var(--paper);
                flex-direction: column;
                gap: 0;
                padding: 1rem var(--gutter) 3rem;
                transform: translateY(-12px);
                opacity: 0;
                pointer-events: none;
                visibility: hidden;
                transition: transform 220ms ease, opacity 220ms ease, visibility 0s linear 220ms;
                overflow-y: auto;
                align-items: flex-start;
            }
            .primary-nav.open {
                transform: translateY(0);
                opacity: 1;
                pointer-events: auto;
                visibility: visible;
                transition: transform 220ms ease, opacity 220ms ease, visibility 0s;
            }
            .primary-nav a {
                font-family: 'Geist', sans-serif;
                font-size: 1.75rem;
                font-weight: 400;
                color: var(--navy);
                padding: 0.85rem 0;
                width: 100%;
                border-bottom: 1px solid var(--hairline);
                min-height: 56px;
            }
            .primary-nav a::after { display: none; }
            .primary-nav .nav-cta {
                font-family: 'Geist', sans-serif;
                font-size: 0.95rem;
                background: var(--navy);
                color: var(--paper);
                margin-top: 1.5rem;
                width: 100%;
                justify-content: center;
                padding: 0.95rem 1rem;
                border-bottom: 0;
                border-radius: var(--radius);
            }
        }

        @media (max-width: 720px) {
            .footer-grid { grid-template-columns: 1fr; gap: 2.5rem; }
            .footer-meta { flex-direction: column; align-items: flex-start; gap: 1rem; }
        }

        /* component-specific styles are added by individual page templates */
        {% block styles %}{% endblock %}
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    <a class="vh" href="#main">Skip to content</a>

    <header class="site-header">
        <div class="site-header__inner">
            <a class="brand" href="/" aria-label="CECAM home">
                <img src="/uploads/cecam-wordmark.png" alt="CECAM — Centre Européen de Calcul Atomique et Moléculaire" width="200" height="42">
            </a>
            <button class="menu-toggle" aria-controls="primary-nav" aria-expanded="false">
                <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
                Menu
            </button>
            {% set cp = nav_active|default('') %}
            <nav id="primary-nav" class="primary-nav" aria-label="Primary">
                <a href="/about"{% if cp == 'about' %} aria-current="page"{% endif %}>About</a>
                <a href="/program"{% if cp == 'program' %} aria-current="page"{% endif %}>Program</a>
                <a href="/activities"{% if cp == 'activities' %} aria-current="page"{% endif %}>Activities</a>
                <a href="/news"{% if cp == 'news' %} aria-current="page"{% endif %}>News</a>
                <a href="/contact"{% if cp == 'contact' %} aria-current="page"{% endif %}>Contact</a>
            </nav>
        </div>
    </header>

    <main id="main">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col footer-brand">
                    <div class="footer-wordmark">
                        <img src="/uploads/cecam-wordmark.png" alt="CECAM" width="220" height="42">
                    </div>
                    <p style="max-width: 28em;">Fostering fundamental research on computational science for societal benefit, across a federated European network anchored at EPFL.</p>
                    <p style="margin-top: 1.2rem;"><span class="badge badge--open"><span class="pulse-dot" aria-hidden="true"></span> Flagship 2027–2028 call open</span></p>
                </div>
                <div class="footer-col">
                    <h4>Headquarters</h4>
                    <address>
                        EPFL CECAM<br>
                        Avenue de Forel 3, BCH 3103<br>
                        1015 Lausanne, Switzerland
                    </address>
                    <p style="margin-top: 0.8rem;"><a href="mailto:helpdesk@cecam.org">helpdesk@cecam.org</a></p>
                </div>
                <div class="footer-col">
                    <h4>Network</h4>
                    <ul>
                        <li><a href="/about">About CECAM</a></li>
                        <li><a href="/program">Program</a></li>
                        <li><a href="/activities">Recurring activities</a></li>
                        <li><a href="/news">News</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                    <div class="footer-mailing" style="margin-top: 1.4rem;">
                        <h4 style="margin-bottom: 0.5rem;">Newsletter</h4>
                        <!-- TODO: replace REPLACE_ME with the real Formspree endpoint when deploying -->
                        <form action="https://formspree.io/f/REPLACE_ME" method="POST">
                            <label class="vh" for="footer-email">Email</label>
                            <input id="footer-email" name="email" type="email" placeholder="you@university.eu" required>
                            <input type="text" name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;">
                            <button type="submit">Subscribe</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="footer-meta">
                <span>© {{ "now"|date('Y') }} CECAM — Centre Européen de Calcul Atomique et Moléculaire · 50 years of computational science</span>
                <ul>
                    <li><a href="/about">Disclaimer</a></li>
                    <li><a href="/about">Privacy</a></li>
                    <li><a href="/contact">Documents</a></li>
                </ul>
            </div>
        </div>
    </footer>

    <script>
        (function () {
            var t = document.querySelector('.menu-toggle');
            var n = document.querySelector('#primary-nav');
            if (!t || !n) return;
            t.addEventListener('click', function () {
                var open = t.getAttribute('aria-expanded') === 'true';
                t.setAttribute('aria-expanded', String(!open));
                n.classList.toggle('open');
                document.body.style.overflow = !open ? 'hidden' : '';
            });
            n.querySelectorAll('a').forEach(function (a) {
                a.addEventListener('click', function () {
                    t.setAttribute('aria-expanded', 'false');
                    n.classList.remove('open');
                    document.body.style.overflow = '';
                });
            });
        })();
    </script>
</body>
</html>
