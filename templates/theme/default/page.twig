{% extends '@theme/layout.twig' %}
{% set meta_description = entry.field('meta_description') %}

{% block title %}{{ entry.field('title') }} · CECAM{% endblock %}

{% block styles %}
        .page-hero {
            padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(2rem, 4vw, 3rem);
            border-bottom: 1px solid var(--hairline);
        }
        .page-hero h1 {
            font-size: clamp(2.4rem, 5.5vw, 4rem);
            line-height: 1.04;
            letter-spacing: -0.022em;
            font-weight: 500;
            color: var(--navy);
            max-width: 20ch;
            font-variation-settings: "opsz" 144;
        }
        .page-hero__crumb {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 1.5rem;
            border-top: 1px solid var(--hairline);
            padding-top: 1rem;
        }

        .page-body { padding: var(--section-y-sm) 0 var(--section-y); }
        .page-body__inner { max-width: var(--prose); margin: 0 auto; font-size: 1.05rem; line-height: 1.7; }
        .page-body__inner p, .page-body__inner ul, .page-body__inner ol { margin: 0 0 1.2em; }
        .page-body__inner h2 { font-size: 1.6rem; margin: 2.5rem 0 0.75rem; }
        .page-body__inner h3 { font-size: 1.25rem; margin: 2rem 0 0.5rem; }
        .page-body__inner a { color: var(--signal); border-bottom: 1px solid currentColor; padding-bottom: 1px; }
{% endblock %}

{% block content %}
<section class="page-hero">
    <div class="container">
        <p class="page-hero__crumb">CECAM</p>
        <h1>{{ entry.field('title') }}</h1>
    </div>
</section>

<section class="page-body">
    <div class="container">
        <div class="page-body__inner">
            {{ entry.field('body')|markdown }}
        </div>
    </div>
</section>
{% endblock %}
